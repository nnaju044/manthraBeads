<!-- ====================================================
     NAVBAR  —  sticky, responsive, accessible
     ==================================================== -->
<a href="#main-content" class="skip-link">Skip to main content</a>

<div class="site-header-wrap" id="siteHeaderWrap">
  <header class="mx-auto flex max-w-[1536px] items-center justify-between gap-4 px-4 py-4 sm:px-8 lg:px-14">

