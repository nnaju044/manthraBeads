<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ManthraBeads | Abacus Academy</title>
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
  <link rel="shortcut icon" href="/images/apple-touch-icon.png">
  <meta name="description"
    content="Interactive virtual soroban abacus for ManthraBeads Academy students. Practice arithmetic with Junior, Intermediate, Advanced and Master modes." />

  <!-- Tailwind CSS (CDN) -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            display: ['"Baloo 2"', '"Poppins"', 'sans-serif'],
            body: ['"Poppins"', 'sans-serif'],
          },
          colors: {
            night: { 950: '#070a1f', 900: '#0b0f2e', 800: '#12183f', 700: '#1a2150' },
          },
          boxShadow: {
            glow: '0 0 25px rgba(255,200,60,0.55)',
            'glow-blue': '0 0 30px rgba(80,140,255,0.45)',
            'glow-pink': '0 0 25px rgba(255,90,200,0.5)',
          },
        },
      },
    };
  </script>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Poppins:wght@400;500;600;700&display=swap"
    rel="stylesheet" />

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
    crossorigin="anonymous" referrerpolicy="no-referrer" />

  <!-- Abacus CSS -->
  <link rel="stylesheet" href="/css/abacus.css" />

  <!-- Site-wide responsive CSS -->
  <link rel="stylesheet" href="/css/site.css" />

  <!-- Excalidraw Whiteboard CSS -->
  <link rel="stylesheet" href="/dist/excalidraw-app.css?v=<%= Date.now() %>" />

  <style>
    /* Scroll overflow for page */
    html,
    body {
      scroll-behavior: smooth;
    }
  </style>
</head>

<body id="abacusBody" class="abacus-page font-body mode-junior">

  <!-- ====================================================
         AMBIENT BACKGROUND BLOBS (fixed behind everything)
         ==================================================== -->
  <div class="pointer-events-none fixed inset-0 overflow-hidden z-0" aria-hidden="true">
    <div class="ambient-blob blob-indigo" style="width:600px;height:600px;top:-120px;left:10%"></div>
    <div class="ambient-blob blob-fuchsia" style="width:500px;height:500px;top:30%;right:-80px"></div>
    <div class="ambient-blob blob-cyan" style="width:400px;height:400px;bottom:0;left:45%;transform:translateX(-50%)">
    </div>
    <span class="absolute top-[8%]  left-[15%] h-1   w-1   rounded-full bg-white/70"></span>
    <span class="absolute top-[18%] left-[45%] h-1   w-1   rounded-full bg-white/50"></span>
    <span class="absolute top-[6%]  left-[70%] h-1.5 w-1.5 rounded-full bg-white/60"></span>
    <span class="absolute top-[40%] left-[8%]  h-1   w-1   rounded-full bg-white/40"></span>
    <span class="absolute top-[65%] left-[92%] h-1   w-1   rounded-full bg-white/50"></span>
  </div>

  <!-- ====================================================
         NAVBAR
         ==================================================== -->
  <%- include('partials/navbar') %>

    <!-- ====================================================
         MAIN
         ==================================================== -->
    <main id="main-content" class="relative z-10 mx-auto max-w-[1536px] px-4 pb-20 sm:px-6 lg:px-8">

      <!-- Page heading -->
      <div class="mt-6 text-center">
        <span
          class="inline-flex items-center gap-1.5 rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-xs font-semibold tracking-wide text-white backdrop-blur-md">
          <i class="fa-solid fa-circle-nodes text-amber-400"></i>
          INTERACTIVE SOROBAN ABACUS
        </span>
        <h1 class="mt-3 font-display text-3xl font-extrabold text-white sm:text-4xl lg:text-5xl">
          Manthra <span
            class="bg-gradient-to-r from-amber-400 to-fuchsia-400 bg-clip-text text-transparent">Beads</span>
        </h1>
        <p class="mt-1.5 text-sm text-indigo-200/60 sm:text-base">
          Click beads to slide them &mdash; Heaven bead = <strong class="text-amber-400">5</strong>,
          Earth beads = <strong class="text-cyan-400">1</strong> each.
        </p>
      </div>

      <!-- ==========================================
           TOOLBAR (glassmorphism panel)
           ========================================== -->
      <div class="toolbar-glass mx-auto mt-6 max-w-4xl px-5 py-4">
        <div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-4">

          <!-- MODE selector -->
          <div>
            <p class="toolbar-label">Mode</p>
            <div class="flex flex-wrap gap-1.5" role="radiogroup" aria-label="Learning mode">
              <button class="mode-btn active" data-mode="junior" id="modeJunior" aria-pressed="true">
                <i class="fa-solid fa-star" style="font-size:0.55rem"></i>Junior
              </button>
              <button class="mode-btn" data-mode="intermediate" id="modeInter" aria-pressed="false">
                <i class="fa-solid fa-bolt" style="font-size:0.55rem"></i>Soroban Red
              </button>
              <button class="mode-btn" data-mode="master" id="modeMaster" aria-pressed="false">
                <i class="fa-solid fa-crown" style="font-size:0.55rem"></i>Walnut Pro
              </button>
            </div>
          </div>

          <!-- Vertical divider -->
          <div class="hidden h-12 w-px bg-white/10 self-center sm:block" aria-hidden="true"></div>

          <!-- ROD COUNT -->
          <div>
            <p class="toolbar-label">Rods</p>
            <select id="rodCountSelect" class="select-pill" aria-label="Number of rods">
              <option value="3">3 Rods</option>
              <option value="5">5 Rods</option>
              <option value="7">7 Rods</option>
              <option value="10">10 Rods</option>
              <option value="13" selected>13 Rods</option>
              <option value="15">15 Rods</option>
              <option value="17">17 Rods</option>
            </select>
          </div>

          <!-- Vertical divider -->
          <div class="hidden h-12 w-px bg-white/10 self-center sm:block" aria-hidden="true"></div>

          <!-- ACTIONS -->
          <div>
            <p class="toolbar-label">Actions</p>
            <div class="flex gap-2">
              <button id="btnReset" class="icon-btn amber" aria-label="Reset abacus to zero">
                <i class="fa-solid fa-rotate-left" style="font-size:0.7rem"></i> Reset
              </button>
              <button id="btnRules" class="icon-btn cyan" aria-label="View abacus rules">
                <i class="fa-solid fa-book-open" style="font-size:0.7rem"></i> Rules
              </button>
              <button id="btnWhiteboard" class="icon-btn indigo" aria-label="Open whiteboard">
                <i class="fa-solid fa-chalkboard" style="font-size:0.7rem"></i> Board
              </button>
              <button id="btnTimer" class="icon-btn" style="background:linear-gradient(135deg,#0ea5e9,#6366f1);border-color:transparent;color:#fff;box-shadow:0 0 18px rgba(14,165,233,0.4)" aria-label="Open stopwatch and timer">
                <i class="fa-solid fa-stopwatch" style="font-size:0.7rem"></i> Timer
              </button>
              <button id="btnMiniTimerToggle" class="icon-btn teal" aria-label="Toggle miniature watch widget" title="Show or hide miniature floating watch">
                <i class="fa-solid fa-clock" style="font-size:0.7rem"></i> Watch
              </button>
            </div>
          </div>

        </div>
      </div>

      <!-- ==========================================
           ABACUS BOARD
           ========================================== -->
      <div class="abacus-wrapper mt-8 pb-10" aria-label="Soroban abacus board">
        <!-- Outer frame: CSS-only polished material -->
        <div id="abacusContainer" class="abacus-frame-outer" style="min-width:180px">
          <!-- Inner playing area -->
          <div class="abacus-frame-inner" style="overflow:visible;position:relative">

            <!-- Horizontal divider beam -->
            <div id="abacusDivider" class="abacus-divider" role="separator" aria-hidden="true"></div>

            <!-- Rods: populated by JS -->
            <div id="rodsContainer" class="abacus-rods-container" role="group" aria-label="Abacus rods"></div>

          </div>
        </div>
      </div>

      <!-- Keyboard help -->
      <p class="info-strip -mt-4">
        <i class="fa-solid fa-keyboard mr-1 opacity-50"></i>
        Tab to focus &bull; Space / Enter to toggle bead &bull; Arrow keys to navigate between beads
      </p>
    </main>

    <!-- ==========================================
         MODALS & OVERLAYS (Top-level stacking)
         ========================================== -->
           RULES PASSWORD MODAL
           ========================================== -->
      <div id="rulesAuthModal"
        class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm hidden transition-opacity duration-200"
        aria-modal="true" role="dialog" aria-labelledby="rulesAuthTitle">
        <div
          class="relative w-full max-w-md rounded-2xl border border-white/15 bg-slate-900/95 p-6 shadow-2xl backdrop-blur-xl">
          <!-- Close button -->
          <button type="button" id="btnRulesAuthClose"
            class="absolute top-4 right-4 flex h-8 w-8 items-center justify-center rounded-full text-indigo-200/60 hover:bg-white/10 hover:text-white transition-colors"
            aria-label="Close dialog">
            <i class="fa-solid fa-xmark text-lg"></i>
          </button>

          <!-- Header -->
          <div class="flex items-center gap-3.5">
            <div
              class="flex h-11 w-11 items-center justify-center rounded-xl bg-amber-400/10 text-amber-400 border border-amber-400/20 shadow-inner">
              <i class="fa-solid fa-lock text-lg"></i>
            </div>
            <div>
              <h3 id="rulesAuthTitle" class="font-display text-lg font-bold text-white tracking-wide">Authentication
                Required</h3>
              <p class="text-xs text-indigo-200/60">Enter passcode to access Rules</p>
            </div>
          </div>

          <!-- Form -->
          <form id="rulesAuthForm" class="mt-5" onsubmit="return false;">
            <div>
              <label for="rulesPasscodeInput"
                class="block text-xs font-semibold uppercase tracking-wider text-indigo-200/70 mb-1.5">Passcode</label>
              <input type="password" id="rulesPasscodeInput"
                class="w-full rounded-xl border border-white/15 bg-white/5 px-4 py-2.5 text-sm text-white placeholder-white/30 focus:border-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-400/30 transition-all"
                placeholder="Enter passcode" autocomplete="off" />
              <p id="rulesPasscodeError"
                class="mt-2 text-xs font-semibold text-rose-400 hidden flex items-center gap-1.5">
                <i class="fa-solid fa-circle-exclamation"></i> Incorrect passcode. Please try again.
              </p>
            </div>

            <div class="mt-6 flex justify-end gap-2.5">
              <button type="button" id="btnRulesAuthCancel"
                class="rounded-full border border-white/15 bg-white/5 px-4 py-2 text-xs font-semibold text-indigo-200/80 hover:bg-white/10 hover:text-white transition-all">
                Cancel
              </button>
              <button type="submit" id="btnRulesAuthSubmit"
                class="rounded-full bg-gradient-to-r from-amber-400 to-amber-500 px-5 py-2 text-xs font-bold text-slate-950 shadow-lg shadow-amber-500/25 hover:brightness-110 active:scale-95 transition-all">
                Authenticate
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- ==========================================
           RULES CONTENT MODAL
           ========================================== -->
      <div id="rulesContentModal"
        class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 bg-black/75 backdrop-blur-md hidden transition-opacity duration-200"
        aria-modal="true" role="dialog" aria-labelledby="rulesModalTitle">
        <div
          class="relative flex flex-col w-full max-w-2xl max-h-[85vh] rounded-2xl border border-white/15 bg-slate-900/95 shadow-2xl backdrop-blur-xl overflow-hidden">

          <!-- Sticky Header -->
          <div class="flex items-center justify-between border-b border-white/10 px-6 py-4 bg-slate-900/80">
            <div class="flex items-center gap-3">
              <div
                class="flex h-10 w-10 items-center justify-center rounded-xl bg-cyan-400/10 text-cyan-400 border border-cyan-400/20 shadow-inner">
                <i class="fa-solid fa-book-open text-lg"></i>
              </div>
              <div>
                <h3 id="rulesModalTitle" class="font-display text-lg font-bold text-white tracking-wide">Soroban Abacus
                  Rules & Guide</h3>
                <p class="text-xs text-indigo-200/60">Official Operating Principles</p>
              </div>
            </div>
            <button type="button" id="btnRulesContentClose"
              class="flex h-8 w-8 items-center justify-center rounded-full text-indigo-200/60 hover:bg-white/10 hover:text-white transition-colors"
              aria-label="Close rules dialog">
              <i class="fa-solid fa-xmark text-lg"></i>
            </button>
          </div>

          <!-- Scrollable Body Content -->
          <div class="flex-1 overflow-y-auto p-6 space-y-6 text-sm leading-relaxed text-indigo-100/90">

            <!-- Section 1 -->
            <div class="rounded-xl border border-white/10 bg-white/5 p-4 space-y-2">
              <h4 class="font-display font-semibold text-amber-400 flex items-center gap-2 text-base">
                <i class="fa-solid fa-layer-group text-xs"></i> 1. Bead Values & Placement
              </h4>
              <ul class="list-disc list-inside space-y-1.5 text-xs sm:text-sm text-indigo-200/80">
                <li><strong class="text-white">Heaven Bead (Upper Deck):</strong> 1 bead per rod, value = <span
                    class="text-amber-400 font-semibold">5</span> when moved down towards the beam.</li>
                <li><strong class="text-white">Earth Beads (Lower Deck):</strong> 4 beads per rod, value = <span
                    class="text-cyan-400 font-semibold">1</span> each when moved up towards the beam.</li>
                <li><strong class="text-white">Active State:</strong> Beads only count toward value when touching or
                  sliding towards the central divider beam.</li>
              </ul>
            </div>

            <!-- Section 2 -->
            <div class="rounded-xl border border-white/10 bg-white/5 p-4 space-y-2">
              <h4 class="font-display font-semibold text-cyan-400 flex items-center gap-2 text-base">
                <i class="fa-solid fa-sliders text-xs"></i> 2. Rods & Unit Dots
              </h4>
              <ul class="list-disc list-inside space-y-1.5 text-xs sm:text-sm text-indigo-200/80">
                <li><strong class="text-white">Center Red Dot:</strong> Placed at the central rod representing the
                  primary <span class="text-rose-400 font-semibold">Units</span> place value.</li>
                <li><strong class="text-white">White Unit Markers:</strong> Positioned every 3 rods to mark Thousands,
                  Millions, etc.</li>
                <li><strong class="text-white">Draggable Markers:</strong> Unit dots can be pressed and dragged to any
                  rod center to customize place-value alignment.</li>
              </ul>
            </div>

            <!-- Section 3 -->
            <div class="rounded-xl border border-white/10 bg-white/5 p-4 space-y-2">
              <h4 class="font-display font-semibold text-fuchsia-400 flex items-center gap-2 text-base">
                <i class="fa-solid fa-keyboard text-xs"></i> 3. Controls & Shortcuts
              </h4>
              <ul class="list-disc list-inside space-y-1.5 text-xs sm:text-sm text-indigo-200/80">
                <li><strong class="text-white">Reset & Clear:</strong> Resets all beads across all rods back to their
                  zero position.</li>
                <li><strong class="text-white">Keyboard Navigation:</strong> Use <kbd
                    class="px-1.5 py-0.5 rounded bg-white/10 border border-white/20 font-mono text-[10px]">Tab</kbd> to
                  focus beads, <kbd
                    class="px-1.5 py-0.5 rounded bg-white/10 border border-white/20 font-mono text-[10px]">Space</kbd>
                  or <kbd
                    class="px-1.5 py-0.5 rounded bg-white/10 border border-white/20 font-mono text-[10px]">Enter</kbd>
                  to toggle, and <kbd
                    class="px-1.5 py-0.5 rounded bg-white/10 border border-white/20 font-mono text-[10px]">Arrow
                    Keys</kbd> to navigate.</li>
              </ul>
            </div>

          </div>

          <!-- Sticky Footer -->
          <div class="flex items-center justify-end border-t border-white/10 px-6 py-4 bg-slate-900/80">
            <button type="button" id="btnRulesContentGotIt"
              class="rounded-full bg-gradient-to-r from-cyan-400 to-cyan-500 px-6 py-2 text-xs font-bold text-slate-950 shadow-lg shadow-cyan-500/25 hover:brightness-110 active:scale-95 transition-all">
              Got it
            </button>
          </div>

        </div>
      </div>

      <!-- ==========================================
           WHITEBOARD MODAL
           ========================================== -->
      <div id="whiteboardModal" class="wb-hidden" role="dialog" aria-modal="true" aria-labelledby="wbModalTitle">
        <div id="whiteboardPanel">
          <div id="excalidrawAppRoot" style="width:100%;height:100%;display:flex;flex-direction:column;overflow:hidden;"></div>
        </div>
      </div>

      <!-- ==========================================
           TIMER MODAL
           ========================================== -->
      <div id="timerModal" class="tm-hidden" role="dialog" aria-modal="true" aria-labelledby="timerModalTitle">
        <div id="timerPanel">

          <!-- Header -->
          <div id="timerHeader">
            <!-- Tab switcher -->
            <div class="tm-tabs" role="tablist">
              <button id="timerTabSw" class="tm-tab tm-tab-active" role="tab" aria-selected="true" aria-controls="timerPaneSw">
                <i class="fa-solid fa-stopwatch" style="font-size:0.7rem"></i> Stopwatch
              </button>
              <button id="timerTabCd" class="tm-tab" role="tab" aria-selected="false" aria-controls="timerPaneCd">
                <i class="fa-solid fa-hourglass-half" style="font-size:0.7rem"></i> Timer
              </button>
            </div>
            <!-- Actions -->
            <div class="flex items-center gap-1.5">
              <button id="timerBtnMini" class="tm-btn-close" aria-label="Switch to miniature watch" title="Switch to miniature watch">
                <i class="fa-solid fa-compress" style="font-size:0.75rem" aria-hidden="true"></i>
              </button>
              <button id="timerBtnClose" class="tm-btn-close" aria-label="Close timer" title="Close timer">
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
              </button>
            </div>
          </div>

          <!-- ── STOPWATCH PANE ── -->
          <div id="timerPaneSw" class="tm-pane" role="tabpanel" aria-labelledby="timerTabSw">
            <!-- Big display -->
            <div id="swDisplay" class="tm-display" aria-live="off" aria-label="Elapsed time">00:00:00.00</div>
            <!-- Controls -->
            <div class="tm-controls">
              <button id="swStart" class="tm-btn tm-btn-primary" aria-label="Start stopwatch">
                <i class="fa-solid fa-play"></i> Start
              </button>
              <button id="swPause" class="tm-btn tm-btn-secondary tm-btn-disabled" disabled aria-label="Pause stopwatch">
                <i class="fa-solid fa-pause"></i> Pause
              </button>
              <button id="swReset" class="tm-btn tm-btn-danger-soft" aria-label="Reset stopwatch">
                <i class="fa-solid fa-rotate-left"></i> Reset
              </button>
            </div>
          </div>

          <!-- ── COUNTDOWN PANE ── -->
          <div id="timerPaneCd" class="tm-pane tm-hidden" role="tabpanel" aria-labelledby="timerTabCd">

            <!-- Circular ring + display -->
            <div class="tm-ring-wrap" aria-hidden="true">
              <svg class="tm-ring-svg" viewBox="0 0 120 120">
                <circle class="tm-ring-track"    cx="60" cy="60" r="54" />
                <circle id="cdProgress" class="tm-ring-progress" cx="60" cy="60" r="54" />
              </svg>
              <div id="cdDisplay" class="tm-display" aria-live="off" aria-label="Time remaining">00:00:00</div>
            </div>

            <!-- HH MM SS inputs -->
            <div class="tm-inputs">
              <div class="tm-input-group">
                <label for="cdHours">Hrs</label>
                <input type="number" id="cdHours" min="0" max="99" value="0" aria-label="Hours" />
              </div>
              <span class="tm-colon">:</span>
              <div class="tm-input-group">
                <label for="cdMinutes">Min</label>
                <input type="number" id="cdMinutes" min="0" max="59" value="5" aria-label="Minutes" />
              </div>
              <span class="tm-colon">:</span>
              <div class="tm-input-group">
                <label for="cdSeconds">Sec</label>
                <input type="number" id="cdSeconds" min="0" max="59" value="0" aria-label="Seconds" />
              </div>
            </div>

            <!-- Finished banner (hidden by default) -->
            <div id="cdFinishedBanner" class="tm-hidden" role="alert">
              <i class="fa-solid fa-bell"></i> Time&rsquo;s up!
            </div>

            <!-- Controls -->
            <div class="tm-controls">
              <button id="cdStart" class="tm-btn tm-btn-primary" aria-label="Start countdown">
                <i class="fa-solid fa-play"></i> Start
              </button>
              <button id="cdPause" class="tm-btn tm-btn-secondary tm-btn-disabled" disabled aria-label="Pause countdown">
                <i class="fa-solid fa-pause"></i> Pause
              </button>
              <button id="cdReset" class="tm-btn tm-btn-danger-soft" aria-label="Reset countdown">
                <i class="fa-solid fa-rotate-left"></i> Reset
              </button>
            </div>
          </div>

        </div>
      </div>

    <script src="/js/abacus.js"></script>
    <script type="module" src="/dist/excalidraw-app.js?v=<%= Date.now() %>"></script>
    <script src="/js/timer.js"></script>
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        // Whiteboard
        WhiteboardModal.init();
        var btnWb = document.getElementById('btnWhiteboard');
        if (btnWb) btnWb.addEventListener('click', function () { WhiteboardModal.open(); });

        // Timer Modal & Miniature Watch
        TimerModal.init();
        var btnTimer = document.getElementById('btnTimer');
        if (btnTimer) btnTimer.addEventListener('click', function () { TimerModal.open(); });

        var btnMiniToggle = document.getElementById('btnMiniTimerToggle');
        if (btnMiniToggle) btnMiniToggle.addEventListener('click', function () { TimerModal.toggleMini(); });

        // Wire timer modal close & mini-view buttons
        var btnTimerClose = document.getElementById('timerBtnClose');
        if (btnTimerClose) btnTimerClose.addEventListener('click', function () { TimerModal.close(); });

        var btnTimerMini = document.getElementById('timerBtnMini');
        if (btnTimerMini) btnTimerMini.addEventListener('click', function () {
          TimerModal.close();
          TimerModal.showMini();
        });
      });
    </script>
    <!-- Miniature Floating Watch / Timer Box (Continuous Moving) -->
    <aside id="miniTimerWidget" class="mini-timer-box" role="region" aria-label="Miniature Watch and Timer">
      <!-- Header (draggable handle) -->
      <div id="miniTimerHeader" class="mini-timer-header" title="Drag to reposition anywhere on screen">
        <div class="mini-timer-handle" id="miniTimerDragHandle">
          <i class="fa-solid fa-grip-vertical mini-drag-icon" aria-hidden="true"></i>
          <span id="miniTimerDot" class="mini-live-dot" title="Timer status"></span>
          <span id="miniTimerModeLabel" class="mini-mode-label">STOPWATCH</span>
        </div>
        <div class="mini-timer-tools">
          <button type="button" id="miniTimerBtnMode" class="mini-tool-btn" title="Cycle mode: Stopwatch / Timer / Clock" aria-label="Cycle timer mode">
            <i class="fa-solid fa-rotate" style="font-size:0.62rem"></i>
          </button>
          <button type="button" id="miniTimerBtnExpand" class="mini-tool-btn" title="Open full timer modal" aria-label="Open full timer modal">
            <i class="fa-solid fa-expand" style="font-size:0.62rem"></i>
          </button>
          <button type="button" id="miniTimerBtnCollapse" class="mini-tool-btn" title="Minimize / Expand" aria-label="Minimize or expand">
            <i class="fa-solid fa-minus" id="miniTimerCollapseIcon" style="font-size:0.62rem"></i>
          </button>
          <button type="button" id="miniTimerBtnClose" class="mini-tool-btn" title="Hide mini watch" aria-label="Hide miniature watch">
            <i class="fa-solid fa-xmark" style="font-size:0.68rem"></i>
          </button>
        </div>
      </div>

      <!-- Watch Face: Continuous Moving Display & Controls -->
      <div id="miniTimerBody" class="mini-timer-body">
        <div class="mini-time-row" title="Click to open full timer modal">
          <span id="miniTimerDisplay" class="mini-time-digits" aria-label="Elapsed time">00:00:00</span>
          <span id="miniTimerMs" class="mini-time-ms">.00</span>
        </div>

        <!-- Quick Controls -->
        <div id="miniTimerControls" class="mini-ctrl-row">
          <button type="button" id="miniTimerBtnStart" class="mini-action-btn mini-start" title="Start timer" aria-label="Start timer">
            <i class="fa-solid fa-play" style="font-size:0.62rem"></i>
          </button>
          <button type="button" id="miniTimerBtnPause" class="mini-action-btn mini-pause" title="Pause timer" aria-label="Pause timer" disabled>
            <i class="fa-solid fa-pause" style="font-size:0.62rem"></i>
          </button>
          <button type="button" id="miniTimerBtnReset" class="mini-action-btn mini-reset" title="Reset timer" aria-label="Reset timer">
            <i class="fa-solid fa-rotate-left" style="font-size:0.62rem"></i>
          </button>
        </div>
      </div>
    </aside>

    <!-- Custom cursor dot lives outside every clipping context -->
    <div id="wbCursorDot" aria-hidden="true"></div>
  </body>

</html>