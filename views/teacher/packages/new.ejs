<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Assign Package to <%= student.name %> | ManthraBeads Teacher</title>
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/images/apple-touch-icon.png" />
    <meta name="description" content="Assign a prepaid class package to a student" />

    <!-- Tailwind CSS (CDN build w/ inline config) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              display: ['"Baloo 2"', '"Poppins"', 'sans-serif'],
              body: ['"Poppins"', 'sans-serif'],
            },
            colors: {
              night: {
                950: '#070a1f',
                900: '#0b0f2e',
                800: '#12183f',
                700: '#1a2150',
              },
            },
          },
        },
      };
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />

    <!-- Site & Teacher CSS -->
    <link rel="stylesheet" href="/css/site.css" />
    <link rel="stylesheet" href="/css/teacher.css" />
  </head>

  <body class="font-body bg-night-950 overflow-x-hidden min-h-screen text-slate-100">
    <section class="relative w-full min-h-screen bg-gradient-to-b from-[#0b1030] via-[#141b4d] to-[#0a1740] pb-20">

      <!-- Ambient Glow Orbs -->
      <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
        <div class="absolute -top-24 left-1/4 h-72 w-72 rounded-full bg-indigo-500/20 blur-[100px] sm:h-96 sm:w-96"></div>
        <div class="absolute top-1/3 right-0 h-64 w-64 rounded-full bg-amber-500/10 blur-[120px] sm:h-[28rem] sm:w-[28rem]"></div>
        <div class="absolute bottom-0 left-1/2 h-56 w-56 -translate-x-1/2 rounded-full bg-cyan-400/10 blur-[100px] sm:h-72 sm:w-72"></div>
      </div>

      <!-- Navbar -->
      <%- include('../../partials/navbar') %>

      <!-- Main Container -->
      <main id="main-content" class="relative z-10 mx-auto max-w-[900px] px-4 pt-6 sm:px-8 sm:pt-8 lg:px-12">

        <!-- Header -->
        <div class="mb-6 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <a
              href="/teacher/students/<%= student._id %>"
              class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-indigo-200 transition hover:bg-white/10 hover:text-white"
              title="Back to Student Profile"
            >
              <i class="fa-solid fa-arrow-left"></i>
            </a>
            <div>
              <h1 class="font-display text-2xl font-bold text-white sm:text-3xl">
                Assign Class Package
              </h1>
              <p class="mt-0.5 text-xs text-indigo-200/60 sm:text-sm">
                Enrolling <span class="font-semibold text-white"><%= student.name %></span> (<%= student.studentId %>) into a prepaid class pack
              </p>
            </div>
          </div>
        </div>

        <!-- Presets Bar -->
        <div class="mb-6 rounded-2xl border border-white/10 bg-white/[0.03] p-4 backdrop-blur-md">
          <p class="text-xs font-semibold uppercase tracking-wider text-indigo-300 mb-2 flex items-center gap-1.5">
            <i class="fa-solid fa-wand-magic-sparkles text-[10px]"></i> Quick Presets
          </p>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
            <% presets.forEach(function(preset) { %>
            <button
              type="button"
              class="preset-btn text-left p-2.5 rounded-xl border border-white/10 bg-white/5 hover:bg-white/10 hover:border-amber-400/40 transition group"
              data-name="<%= preset.name %>"
              data-classes="<%= preset.classes %>"
              data-price="<%= preset.priceRs %>"
            >
              <span class="font-medium text-xs text-white block group-hover:text-amber-300"><%= preset.name %></span>
              <span class="text-[11px] text-indigo-200/60 block"><%= preset.classes %> classes &bull; ₹<%= preset.priceRs %></span>
            </button>
            <% }); %>
          </div>
        </div>

        <!-- Form Card -->
        <div class="glass-card p-6 sm:p-10">
          <form action="/teacher/students/<%= student._id %>/packages" method="POST" class="space-y-6" novalidate>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

            <!-- Row 1: Package Name & Classes -->
            <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
              <div class="sm:col-span-2">
                <label for="packageName" class="mb-1.5 block text-xs font-semibold uppercase tracking-wider text-indigo-200/70">
                  Package Name <span class="text-rose-400">*</span>
                </label>
                <input
                  type="text"
                  id="packageName"
                  name="packageName"
                  required
                  placeholder="e.g. 4-Class Starter Pack"
                  value="<%= form.packageName || '' %>"
                  class="teacher-input <%= locals.errors && errors.packageName ? 'border-rose-400' : '' %>"
                />
                <% if (locals.errors && errors.packageName) { %>
                <p class="mt-1 text-xs text-rose-300"><%= errors.packageName %></p>
                <% } %>
              </div>

              <div>
                <label for="totalClasses" class="mb-1.5 block text-xs font-semibold uppercase tracking-wider text-indigo-200/70">
                  Number of Classes <span class="text-rose-400">*</span>
                </label>
                <input
                  type="number"
                  id="totalClasses"
                  name="totalClasses"
                  required
                  min="1"
                  max="500"
                  step="1"
                  placeholder="4"
                  value="<%= form.totalClasses || 4 %>"
                  class="teacher-input font-semibold text-white <%= locals.errors && errors.totalClasses ? 'border-rose-400' : '' %>"
                />
                <% if (locals.errors && errors.totalClasses) { %>
                <p class="mt-1 text-xs text-rose-300"><%= errors.totalClasses %></p>
                <% } %>
              </div>
            </div>

            <!-- Row 2: Price & Purchase Date -->
            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
              <div>
                <label for="priceRupees" class="mb-1.5 block text-xs font-semibold uppercase tracking-wider text-indigo-200/70">
                  Total Package Price (₹) <span class="text-rose-400">*</span>
                </label>
                <div class="relative">
                  <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-indigo-200/60 font-semibold">
                    ₹
                  </span>
                  <input
                    type="number"
                    id="priceRupees"
                    name="priceRupees"
                    required
                    min="0"
                    step="0.01"
                    placeholder="1000"
                    value="<%= form.priceRupees || '' %>"
                    class="teacher-input pl-8 font-semibold text-white <%= locals.errors && errors.priceRupees ? 'border-rose-400' : '' %>"
                  />
                </div>
                <% if (locals.errors && errors.priceRupees) { %>
                <p class="mt-1 text-xs text-rose-300"><%= errors.priceRupees %></p>
                <% } %>
              </div>

              <div>
                <label for="purchaseDate" class="mb-1.5 block text-xs font-semibold uppercase tracking-wider text-indigo-200/70">
                  Purchase Date <span class="text-rose-400">*</span>
                </label>
                <input
                  type="date"
                  id="purchaseDate"
                  name="purchaseDate"
                  required
                  value="<%= form.purchaseDate || new Date().toISOString().split('T')[0] %>"
                  class="teacher-input text-white"
                />
              </div>
            </div>

            <!-- Divider: Initial Payment Section -->
            <div class="border-t border-white/10 pt-4">
              <h3 class="text-sm font-semibold uppercase tracking-wider text-amber-300 mb-1 flex items-center gap-2">
                <i class="fa-solid fa-receipt text-amber-400 text-xs"></i> Initial Payment Recording
              </h3>
              <p class="text-xs text-indigo-200/60 mb-4">
                Record fees collected right now (full or partial). If no payment was collected yet, enter ₹0.
              </p>
            </div>

            <!-- Row 3: Initial Payment Amount & Method -->
            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
              <div>
                <label for="initialPaymentRupees" class="mb-1.5 block text-xs font-semibold uppercase tracking-wider text-indigo-200/70">
                  Amount Received Today (₹)
                </label>
                <div class="relative">
                  <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-indigo-200/60 font-semibold">
                    ₹
                  </span>
                  <input
                    type="number"
                    id="initialPaymentRupees"
                    name="initialPaymentRupees"
                    min="0"
                    step="0.01"
                    placeholder="1000"
                    value="<%= form.initialPaymentRupees || '' %>"
                    class="teacher-input pl-8 font-semibold text-emerald-300 <%= locals.errors && errors.initialPaymentRupees ? 'border-rose-400' : '' %>"
                  />
                </div>
                <% if (locals.errors && errors.initialPaymentRupees) { %>
                <p class="mt-1 text-xs text-rose-300"><%= errors.initialPaymentRupees %></p>
                <% } %>
              </div>

              <div>
                <label for="paymentMethod" class="mb-1.5 block text-xs font-semibold uppercase tracking-wider text-indigo-200/70">
                  Payment Method
                </label>
                <select id="paymentMethod" name="paymentMethod" class="teacher-input bg-[#0e1438] text-white">
                  <option value="upi" <%= (form.paymentMethod === 'upi') ? 'selected' : '' %>>UPI (GPay / PhonePe / Paytm)</option>
                  <option value="cash" <%= (form.paymentMethod === 'cash') ? 'selected' : '' %>>Cash</option>
                  <option value="bank_transfer" <%= (form.paymentMethod === 'bank_transfer') ? 'selected' : '' %>>Bank Transfer (NEFT / IMPS)</option>
                  <option value="cheque" <%= (form.paymentMethod === 'cheque') ? 'selected' : '' %>>Cheque</option>
                  <option value="other" <%= (form.paymentMethod === 'other') ? 'selected' : '' %>>Other</option>
                </select>
              </div>
            </div>

            <!-- Row 4: Ref Number & Notes -->
            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
              <div>
                <label for="referenceNumber" class="mb-1.5 block text-xs font-semibold uppercase tracking-wider text-indigo-200/70">
                  Reference / UTR Number <span class="text-[10px] text-indigo-300/60">(Optional)</span>
                </label>
                <input
                  type="text"
                  id="referenceNumber"
                  name="referenceNumber"
                  placeholder="e.g. UPI Ref 3291823901"
                  value="<%= form.referenceNumber || '' %>"
                  class="teacher-input font-mono"
                />
              </div>

              <div>
                <label for="notes" class="mb-1.5 block text-xs font-semibold uppercase tracking-wider text-indigo-200/70">
                  Package Notes <span class="text-[10px] text-indigo-300/60">(Optional)</span>
                </label>
                <input
                  type="text"
                  id="notes"
                  name="notes"
                  placeholder="Batch timing, discount applied, etc."
                  value="<%= form.notes || '' %>"
                  class="teacher-input"
                />
              </div>
            </div>

            <!-- Buttons -->
            <div class="flex flex-col-reverse sm:flex-row items-center justify-end gap-3 pt-6 border-t border-white/10">
              <a
                href="/teacher/students/<%= student._id %>"
                class="btn-ghost w-full sm:w-auto justify-center px-6"
              >
                Cancel
              </a>
              <button
                type="submit"
                class="btn-primary w-full sm:w-auto px-8"
              >
                <i class="fa-solid fa-check"></i>
                <span>Assign Package</span>
              </button>
            </div>

          </form>
        </div>

      </main>
    </section>

    <!-- Preset Auto-fill Script -->
    <script>
    document.querySelectorAll('.preset-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var name = this.getAttribute('data-name');
        var classes = this.getAttribute('data-classes');
        var price = this.getAttribute('data-price');
        document.getElementById('packageName').value = name;
        document.getElementById('totalClasses').value = classes;
        document.getElementById('priceRupees').value = price;
        document.getElementById('initialPaymentRupees').value = price;
      });
    });
    </script>
  </body>
</html>
