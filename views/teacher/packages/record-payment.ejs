<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Record Payment — <%= pkg.packageName %> | ManthraBeads Teacher</title>
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/images/apple-touch-icon.png" />
    <meta name="description" content="Record a payment transaction for a student package" />

    <!-- Tailwind CSS (CDN build w/ inline config) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              display: ['"Baloo 2"', '"Poppins"', 'sans-serif'],
              body: ['"Poppins"', 'sans-serif'],
            },
            colors: {
              night: {
                950: '#070a1f',
                900: '#0b0f2e',
                800: '#12183f',
                700: '#1a2150',
              },
            },
          },
        },
      };
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />

    <!-- Site & Teacher CSS -->
    <link rel="stylesheet" href="/css/site.css" />
    <link rel="stylesheet" href="/css/teacher.css" />
  </head>

  <body class="font-body bg-night-950 overflow-x-hidden min-h-screen text-slate-100">
    <section class="relative w-full min-h-screen bg-gradient-to-b from-[#0b1030] via-[#141b4d] to-[#0a1740] pb-20">

      <!-- Ambient Glow Orbs -->
      <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
        <div class="absolute -top-24 left-1/4 h-72 w-72 rounded-full bg-indigo-500/20 blur-[100px] sm:h-96 sm:w-96"></div>
        <div class="absolute top-1/3 right-0 h-64 w-64 rounded-full bg-emerald-500/10 blur-[120px] sm:h-[28rem] sm:w-[28rem]"></div>
        <div class="absolute bottom-0 left-1/2 h-56 w-56 -translate-x-1/2 rounded-full bg-cyan-400/10 blur-[100px] sm:h-72 sm:w-72"></div>
      </div>

      <!-- Navbar -->
      <%- include('../../partials/navbar') %>

      <!-- Main Container -->
      <main id="main-content" class="relative z-10 mx-auto max-w-4xl px-4 pt-6 sm:px-8 sm:pt-8 lg:px-12">

        <!-- Top Header & Back -->
        <div class="mb-6 flex items-center gap-3">
          <a
            href="/teacher/packages/<%= pkg._id %>"
            class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-indigo-200 transition hover:bg-white/10 hover:text-white"
            title="Back to Package Details"
          >
            <i class="fa-solid fa-arrow-left"></i>
          </a>
          <div>
            <h1 class="font-display text-2xl font-bold text-white sm:text-3xl">
              Record Payment
            </h1>
            <p class="mt-0.5 text-xs text-indigo-200/60 sm:text-sm">
              Logging transaction for <strong class="text-white"><%= student.name %></strong> &bull; <%= pkg.packageName %>
            </p>
          </div>
        </div>

        <!-- Package Context Banner -->
        <div class="glass-card mb-8 border border-indigo-400/20 bg-gradient-to-r from-indigo-900/30 via-purple-900/20 to-slate-900/30 p-5 sm:p-6">
          <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
            <div>
              <span class="text-xs uppercase tracking-wider text-indigo-200/60">Package Price</span>
              <p class="mt-1 font-display text-lg font-bold text-white sm:text-xl">
                <%= formatRupees(pkg.totalPricePaise) %>
              </p>
            </div>
            <div>
              <span class="text-xs uppercase tracking-wider text-indigo-200/60">Amount Paid</span>
              <p class="mt-1 font-display text-lg font-bold text-emerald-400 sm:text-xl">
                <%= formatRupees(pkg.amountPaidPaise) %>
              </p>
            </div>
            <div>
              <span class="text-xs uppercase tracking-wider text-indigo-200/60">Outstanding Dues</span>
              <p class="mt-1 font-display text-lg font-bold <%= pkg.outstandingDuesPaise > 0 ? 'text-amber-400' : 'text-slate-400' %> sm:text-xl">
                <%= formatRupees(pkg.outstandingDuesPaise) %>
              </p>
            </div>
            <div>
              <span class="text-xs uppercase tracking-wider text-indigo-200/60">Classes</span>
              <p class="mt-1 font-display text-lg font-bold text-indigo-200 sm:text-xl">
                <%= pkg.consumedClasses %> / <%= pkg.totalClasses %> <span class="text-xs font-normal text-indigo-200/60">done</span>
              </p>
            </div>
          </div>
        </div>

        <!-- General Error Alert -->
        <% if (errors && errors.general) { %>
          <div class="mb-6 flex items-start gap-3 rounded-2xl border border-rose-500/30 bg-rose-500/10 p-4 text-rose-200">
            <i class="fa-solid fa-triangle-exclamation mt-0.5 text-rose-400"></i>
            <div>
              <h3 class="text-sm font-semibold text-rose-300">Payment Recording Error</h3>
              <p class="text-xs mt-0.5"><%= errors.general %></p>
            </div>
          </div>
        <% } %>

        <!-- Record Payment Form -->
        <form
          action="/teacher/packages/<%= pkg._id %>/payments"
          method="POST"
          class="glass-card space-y-6 border border-white/10 p-6 sm:p-8"
        >
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

          <!-- Amount Field -->
          <div>
            <div class="flex items-center justify-between">
              <label for="amountRupees" class="block text-sm font-medium text-slate-200">
                Payment Amount (₹) <span class="text-rose-400">*</span>
              </label>
              <% if (pkg.outstandingDuesPaise > 0) { %>
                <button
                  type="button"
                  id="btn-fill-dues"
                  data-dues="<%= (pkg.outstandingDuesPaise / 100).toFixed(2) %>"
                  class="text-xs font-semibold text-indigo-300 hover:text-indigo-200 underline"
                >
                  Pay Outstanding (<%= formatRupees(pkg.outstandingDuesPaise) %>)
                </button>
              <% } %>
            </div>

            <div class="relative mt-2">
              <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-lg font-bold text-indigo-300">
                ₹
              </span>
              <input
                type="number"
                name="amountRupees"
                id="amountRupees"
                step="0.01"
                min="1"
                max="1000000"
                required
                value="<%= form && form.amountRupees ? form.amountRupees : (suggestedAmount > 0 ? suggestedAmount : '') %>"
                placeholder="e.g. 1000"
                class="w-full rounded-xl border border-white/10 bg-white/5 py-3 pl-9 pr-4 text-lg font-semibold text-white placeholder-slate-500 focus:border-indigo-400 focus:outline-none focus:ring-1 focus:ring-indigo-400"
              />
            </div>
            <% if (errors && errors.amountRupees) { %>
              <p class="mt-1.5 text-xs text-rose-400"><%= errors.amountRupees %></p>
            <% } %>
            <p class="mt-1 text-xs text-indigo-200/50">
              Payments are recorded in integer paise internally for zero floating-point loss.
            </p>
          </div>

          <!-- Quick Fill Suggestions -->
          <div class="flex flex-wrap gap-2 pt-1">
            <span class="text-xs text-indigo-200/50 self-center">Quick values:</span>
            <% [500, 1000, 1500, 2000, 3000].forEach(amt => { %>
              <button
                type="button"
                class="btn-quick-amount rounded-lg border border-white/10 bg-white/5 px-2.5 py-1 text-xs font-semibold text-slate-300 hover:bg-white/10 hover:text-white transition"
                data-amount="<%= amt %>"
              >
                ₹<%= amt %>
              </button>
            <% }) %>
          </div>

          <!-- Payment Method & Date -->
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            <div>
              <label for="paymentMethod" class="block text-sm font-medium text-slate-200">
                Payment Method <span class="text-rose-400">*</span>
              </label>
              <select
                name="paymentMethod"
                id="paymentMethod"
                required
                class="mt-2 w-full rounded-xl border border-white/10 bg-[#12183f] px-4 py-3 text-sm text-white focus:border-indigo-400 focus:outline-none focus:ring-1 focus:ring-indigo-400"
              >
                <option value="upi" <%= form && form.paymentMethod === 'upi' ? 'selected' : '' %>>UPI (GPay / PhonePe / Paytm)</option>
                <option value="cash" <%= form && form.paymentMethod === 'cash' ? 'selected' : '' %>>Cash in Hand</option>
                <option value="bank_transfer" <%= form && form.paymentMethod === 'bank_transfer' ? 'selected' : '' %>>Bank Transfer (NEFT / IMPS / RTGS)</option>
                <option value="cheque" <%= form && form.paymentMethod === 'cheque' ? 'selected' : '' %>>Cheque / Demand Draft</option>
                <option value="other" <%= form && form.paymentMethod === 'other' ? 'selected' : '' %>>Other</option>
              </select>
              <% if (errors && errors.paymentMethod) { %>
                <p class="mt-1.5 text-xs text-rose-400"><%= errors.paymentMethod %></p>
              <% } %>
            </div>

            <div>
              <label for="paymentDate" class="block text-sm font-medium text-slate-200">
                Payment Date <span class="text-rose-400">*</span>
              </label>
              <input
                type="date"
                name="paymentDate"
                id="paymentDate"
                required
                value="<%= form && form.paymentDate ? form.paymentDate : new Date().toISOString().split('T')[0] %>"
                class="mt-2 w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-white focus:border-indigo-400 focus:outline-none focus:ring-1 focus:ring-indigo-400"
              />
              <% if (errors && errors.paymentDate) { %>
                <p class="mt-1.5 text-xs text-rose-400"><%= errors.paymentDate %></p>
              <% } %>
            </div>
          </div>

          <!-- Transaction Reference -->
          <div>
            <label for="referenceNumber" class="block text-sm font-medium text-slate-200">
              Reference / Transaction ID <span class="text-xs text-indigo-200/50">(Optional)</span>
            </label>
            <input
              type="text"
              name="referenceNumber"
              id="referenceNumber"
              maxlength="100"
              placeholder="e.g. UPI Ref / Bank UTR / Cheque #"
              value="<%= form && form.referenceNumber ? form.referenceNumber : '' %>"
              class="mt-2 w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-white placeholder-slate-500 focus:border-indigo-400 focus:outline-none focus:ring-1 focus:ring-indigo-400"
            />
          </div>

          <!-- Notes -->
          <div>
            <label for="notes" class="block text-sm font-medium text-slate-200">
              Notes / Receipt memo <span class="text-xs text-indigo-200/50">(Optional)</span>
            </label>
            <textarea
              name="notes"
              id="notes"
              rows="3"
              maxlength="500"
              placeholder="e.g. Paid by parent via Google Pay, installment 2 of 2"
              class="mt-2 w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-white placeholder-slate-500 focus:border-indigo-400 focus:outline-none focus:ring-1 focus:ring-indigo-400"
            ><%= form && form.notes ? form.notes : '' %></textarea>
          </div>

          <!-- Notice on Class Credits -->
          <div class="rounded-xl border border-indigo-400/20 bg-indigo-900/20 p-3.5 text-xs text-indigo-200/80">
            <i class="fa-solid fa-circle-info mr-1 text-indigo-300"></i>
            <strong>Financial ledger rule:</strong> Recording this payment credits the student's package ledger and lowers their outstanding dues. It does <strong>not</strong> consume class credits. Class credits are consumed when attendance is marked.
          </div>

          <!-- Form Actions -->
          <div class="flex flex-col-reverse gap-3 pt-2 sm:flex-row sm:items-center sm:justify-end">
            <a
              href="/teacher/packages/<%= pkg._id %>"
              class="inline-flex items-center justify-center rounded-full border border-white/10 bg-white/5 px-6 py-3 text-sm font-medium text-slate-300 transition hover:bg-white/10 hover:text-white"
            >
              Cancel
            </a>
            <button
              type="submit"
              class="inline-flex items-center justify-center gap-2 rounded-full bg-gradient-to-r from-emerald-500 to-teal-500 px-7 py-3 text-sm font-semibold text-white shadow-[0_0_25px_rgba(16,185,129,0.35)] transition hover:brightness-110"
            >
              <i class="fa-solid fa-check"></i>
              <span>Save Payment</span>
            </button>
          </div>
        </form>

      </main>
    </section>

    <!-- Quick Amount Script -->
    <script>
      (function() {
        const fillDuesBtn = document.getElementById('btn-fill-dues');
        const amountInput = document.getElementById('amountRupees');

        if (fillDuesBtn && amountInput) {
          fillDuesBtn.addEventListener('click', function() {
            amountInput.value = this.dataset.dues;
            amountInput.focus();
          });
        }

        document.querySelectorAll('.btn-quick-amount').forEach(btn => {
          btn.addEventListener('click', function() {
            if (amountInput) {
              amountInput.value = this.dataset.amount;
              amountInput.focus();
            }
          });
        });
      })();
    </script>
  </body>
</html>
