<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Teacher Login | ManthraBeads</title>
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
    <link rel="shortcut icon" href="/images/apple-touch-icon.png">
    <meta name="description" content="ManthraBeads teacher portal — sign in to manage students, attendance, and class packages." />

    <!-- Tailwind CSS (CDN build w/ inline config) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              display: ['"Baloo 2"', '"Poppins"', 'sans-serif'],
              body: ['"Poppins"', 'sans-serif'],
            },
            colors: {
              night: {
                950: '#070a1f',
                900: '#0b0f2e',
                800: '#12183f',
                700: '#1a2150',
              },
            },
            boxShadow: {
              glow: '0 0 25px rgba(255, 200, 60, 0.55)',
              'glow-blue': '0 0 30px rgba(80, 140, 255, 0.45)',
              'glow-pink': '0 0 25px rgba(255, 90, 200, 0.5)',
            },
          },
        },
      };
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
      integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />

    <!-- Site-wide responsive CSS -->
    <link rel="stylesheet" href="/css/site.css" />
    <!-- Teacher panel CSS -->
    <link rel="stylesheet" href="/css/teacher.css" />
  </head>

  <body class="font-body bg-night-950 overflow-x-hidden">
    <section class="relative w-full min-h-screen overflow-x-hidden bg-gradient-to-b from-[#0b1030] via-[#141b4d] to-[#0a1740]">

      <!-- ── Starfield / ambient glow ── -->
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="absolute -top-24 left-1/4 h-72 w-72 rounded-full bg-indigo-500/20 blur-[100px] sm:h-96 sm:w-96"></div>
        <div class="absolute top-1/3 right-0 h-64 w-64 rounded-full bg-fuchsia-500/10 blur-[120px] sm:h-[28rem] sm:w-[28rem]"></div>
        <div class="absolute bottom-0 left-1/2 h-56 w-56 -translate-x-1/2 rounded-full bg-cyan-400/10 blur-[100px] sm:h-72 sm:w-72"></div>
        <span class="absolute top-[8%] left-[15%] h-1 w-1 rounded-full bg-white/70"></span>
        <span class="absolute top-[18%] left-[45%] h-1 w-1 rounded-full bg-white/50"></span>
        <span class="absolute top-[6%] left-[70%] h-1.5 w-1.5 rounded-full bg-white/60"></span>
        <span class="absolute top-[40%] left-[8%] h-1 w-1 rounded-full bg-white/40"></span>
        <span class="absolute top-[65%] left-[92%] h-1 w-1 rounded-full bg-white/50"></span>
      </div>

      <!-- ── Navbar ── -->
      <%- include('../partials/navbar') %>

      <!-- ── Login Card ── -->
      <main id="main-content" class="relative z-10 flex items-center justify-center px-4 pt-12 pb-16 sm:pt-16">
        <div class="w-full max-w-md">

          <!-- Glass card -->
          <div class="glass-card p-6 sm:p-8">

            <!-- Logo & heading -->
            <div class="mb-6 text-center sm:mb-8">
              <div class="mx-auto mb-3 flex h-16 w-16 items-center justify-center rounded-2xl border border-white/10 bg-gradient-to-br from-indigo-500/20 to-violet-500/20">
                <i class="fa-solid fa-chalkboard-user text-2xl text-indigo-300" aria-hidden="true"></i>
              </div>
              <h1 class="font-display text-2xl font-bold text-white sm:text-3xl">Teacher Portal</h1>
              <p class="mt-1 text-sm text-indigo-200/60">Sign in to manage your classes</p>
            </div>

            <!-- Error alert -->
            <% if (typeof error !== 'undefined' && error) { %>
            <div class="teacher-alert error">
              <i class="fa-solid fa-circle-exclamation shrink-0 text-rose-400" aria-hidden="true"></i>
              <span><%= error %></span>
            </div>
            <% } %>

            <!-- Login form -->
            <form action="/teacher/login" method="POST" class="flex flex-col gap-4" autocomplete="on">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

              <div>
                <label for="loginEmail" class="mb-1.5 block text-xs font-semibold uppercase tracking-wider text-indigo-200/60">
                  Email
                </label>
                <input
                  type="email"
                  id="loginEmail"
                  name="email"
                  required
                  autocomplete="email"
                  placeholder="teacher@manthrabeads.com"
                  class="teacher-input"
                />
              </div>

              <div>
                <label for="loginPassword" class="mb-1.5 block text-xs font-semibold uppercase tracking-wider text-indigo-200/60">
                  Password
                </label>
                <div class="relative">
                  <input
                    type="password"
                    id="loginPassword"
                    name="password"
                    required
                    autocomplete="current-password"
                    placeholder="••••••••"
                    class="teacher-input pr-11"
                  />
                  <button
                    type="button"
                    id="togglePassword"
                    class="absolute right-3 top-1/2 -translate-y-1/2 text-indigo-200/40 transition hover:text-white"
                    aria-label="Toggle password visibility"
                    tabindex="-1"
                  >
                    <i id="eyeIcon" class="fa-solid fa-eye text-sm"></i>
                  </button>
                </div>
              </div>

              <button type="submit" class="btn-primary mt-2">
                Sign In
                <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
              </button>
            </form>
          </div>

          <!-- Back link -->
          <div class="mt-6 text-center">
            <a href="/" class="text-sm text-indigo-200/50 transition hover:text-white">
              <i class="fa-solid fa-arrow-left mr-1" aria-hidden="true"></i> Back to ManthraBeads
            </a>
          </div>
        </div>
      </main>
    </section>

    <!-- Password toggle script -->
    <script>
    (function () {
      var btn  = document.getElementById('togglePassword');
      var inp  = document.getElementById('loginPassword');
      var icon = document.getElementById('eyeIcon');
      if (!btn || !inp) return;
      btn.addEventListener('click', function () {
        var hidden = inp.type === 'password';
        inp.type = hidden ? 'text' : 'password';
        icon.classList.toggle('fa-eye', !hidden);
        icon.classList.toggle('fa-eye-slash', hidden);
        btn.setAttribute('aria-label', hidden ? 'Hide password' : 'Show password');
      });
    })();
    </script>
  </body>
</html>
