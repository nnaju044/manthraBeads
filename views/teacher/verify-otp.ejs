<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify OTP | ManthraBeads Teacher</title>
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
    <link rel="shortcut icon" href="/images/apple-touch-icon.png">
    <meta name="description" content="Enter your 6-digit verification code to reset your teacher password." />

    <!-- Tailwind CSS (CDN build w/ inline config) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              display: ['"Baloo 2"', '"Poppins"', 'sans-serif'],
              body: ['"Poppins"', 'sans-serif'],
            },
            colors: {
              night: {
                950: '#070a1f',
                900: '#0b0f2e',
                800: '#12183f',
                700: '#1a2150',
              },
            },
            boxShadow: {
              glow: '0 0 25px rgba(255, 200, 60, 0.55)',
              'glow-blue': '0 0 30px rgba(80, 140, 255, 0.45)',
              'glow-pink': '0 0 25px rgba(255, 90, 200, 0.5)',
            },
          },
        },
      };
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
      integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />

    <!-- Site-wide responsive CSS & Teacher panel CSS -->
    <link rel="stylesheet" href="/css/site.css" />
    <link rel="stylesheet" href="/css/teacher.css" />
  </head>

  <body class="font-body bg-night-950 overflow-x-hidden">
    <section class="relative w-full min-h-screen overflow-x-hidden bg-gradient-to-b from-[#0b1030] via-[#141b4d] to-[#0a1740]">

      <!-- Starfield / ambient glow -->
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="absolute -top-24 left-1/4 h-72 w-72 rounded-full bg-indigo-500/20 blur-[100px] sm:h-96 sm:w-96"></div>
        <div class="absolute top-1/3 right-0 h-64 w-64 rounded-full bg-fuchsia-500/10 blur-[120px] sm:h-[28rem] sm:w-[28rem]"></div>
        <div class="absolute bottom-0 left-1/2 h-56 w-56 -translate-x-1/2 rounded-full bg-cyan-400/10 blur-[100px] sm:h-72 sm:w-72"></div>
      </div>

      <!-- Navbar -->
      <%- include('../partials/navbar') %>

      <!-- OTP Card -->
      <main id="main-content" class="relative z-10 flex items-center justify-center px-4 pt-12 pb-16 sm:pt-16">
        <div class="w-full max-w-md">

          <div class="glass-card p-6 sm:p-8">

            <!-- Icon & Heading -->
            <div class="mb-6 text-center sm:mb-8">
              <div class="mx-auto mb-3 flex h-16 w-16 items-center justify-center rounded-2xl border border-indigo-400/30 bg-gradient-to-br from-indigo-500/20 to-violet-500/20 text-indigo-300">
                <i class="fa-solid fa-shield-halved text-2xl" aria-hidden="true"></i>
              </div>
              <h1 class="font-display text-2xl font-bold text-white sm:text-3xl">Verify OTP</h1>
              <p class="mt-1 text-sm text-indigo-200/60">
                Enter the 6-digit verification code sent to:
              </p>
              <p class="mt-0.5 text-xs font-semibold text-indigo-300">
                <%= email %>
              </p>
            </div>

            <!-- Error alert -->
            <% if (typeof error !== 'undefined' && error) { %>
              <div class="teacher-alert error mb-4" id="serverErrorAlert">
                <i class="fa-solid fa-circle-exclamation shrink-0 text-rose-400" aria-hidden="true"></i>
                <span><%= error %></span>
              </div>
            <% } %>

            <!-- Info alert -->
            <% if (typeof info !== 'undefined' && info) { %>
              <div class="mb-4 flex items-center gap-2.5 rounded-xl border border-indigo-400/30 bg-indigo-500/15 p-3 text-xs text-indigo-200" id="serverInfoAlert">
                <i class="fa-solid fa-circle-check shrink-0 text-emerald-400" aria-hidden="true"></i>
                <span><%= info %></span>
              </div>
            <% } %>

            <!-- OTP Expiration Live Countdown -->
            <div class="mb-5 flex items-center justify-between rounded-xl border border-white/10 bg-white/[0.03] px-3.5 py-2.5 text-xs text-indigo-200/80">
              <span class="flex items-center gap-2">
                <i class="fa-regular fa-clock text-indigo-400"></i>
                <span>Code expires in:</span>
              </span>
              <span id="countdownTimer" class="font-mono font-bold text-indigo-300">05:00</span>
            </div>

            <!-- OTP Submission Form -->
            <form action="/teacher/verify-otp" method="POST" id="verifyOtpForm" class="flex flex-col gap-4">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <input type="hidden" name="email" value="<%= email %>" />
              <input type="hidden" name="otp" id="combinedOtpInput" />

              <div>
                <label class="mb-2 block text-center text-xs font-semibold uppercase tracking-wider text-indigo-200/60">
                  6-Digit Verification Code
                </label>
                <!-- 6 Individual Digit Inputs -->
                <div class="flex justify-center gap-2 sm:gap-3" id="otpInputsContainer">
                  <input
                    type="text"
                    inputmode="numeric"
                    pattern="[0-9]*"
                    maxlength="1"
                    data-index="0"
                    class="otp-digit h-12 w-11 sm:h-14 sm:w-12 text-center text-xl sm:text-2xl font-bold font-mono rounded-xl border border-white/15 bg-white/[0.05] text-white shadow-inner focus:border-indigo-400 focus:bg-white/[0.08] focus:outline-none focus:ring-2 focus:ring-indigo-400/40 transition"
                    autofocus
                    autocomplete="one-time-code"
                  />
                  <input
                    type="text"
                    inputmode="numeric"
                    pattern="[0-9]*"
                    maxlength="1"
                    data-index="1"
                    class="otp-digit h-12 w-11 sm:h-14 sm:w-12 text-center text-xl sm:text-2xl font-bold font-mono rounded-xl border border-white/15 bg-white/[0.05] text-white shadow-inner focus:border-indigo-400 focus:bg-white/[0.08] focus:outline-none focus:ring-2 focus:ring-indigo-400/40 transition"
                    autocomplete="off"
                  />
                  <input
                    type="text"
                    inputmode="numeric"
                    pattern="[0-9]*"
                    maxlength="1"
                    data-index="2"
                    class="otp-digit h-12 w-11 sm:h-14 sm:w-12 text-center text-xl sm:text-2xl font-bold font-mono rounded-xl border border-white/15 bg-white/[0.05] text-white shadow-inner focus:border-indigo-400 focus:bg-white/[0.08] focus:outline-none focus:ring-2 focus:ring-indigo-400/40 transition"
                    autocomplete="off"
                  />
                  <input
                    type="text"
                    inputmode="numeric"
                    pattern="[0-9]*"
                    maxlength="1"
                    data-index="3"
                    class="otp-digit h-12 w-11 sm:h-14 sm:w-12 text-center text-xl sm:text-2xl font-bold font-mono rounded-xl border border-white/15 bg-white/[0.05] text-white shadow-inner focus:border-indigo-400 focus:bg-white/[0.08] focus:outline-none focus:ring-2 focus:ring-indigo-400/40 transition"
                    autocomplete="off"
                  />
                  <input
                    type="text"
                    inputmode="numeric"
                    pattern="[0-9]*"
                    maxlength="1"
                    data-index="4"
                    class="otp-digit h-12 w-11 sm:h-14 sm:w-12 text-center text-xl sm:text-2xl font-bold font-mono rounded-xl border border-white/15 bg-white/[0.05] text-white shadow-inner focus:border-indigo-400 focus:bg-white/[0.08] focus:outline-none focus:ring-2 focus:ring-indigo-400/40 transition"
                    autocomplete="off"
                  />
                  <input
                    type="text"
                    inputmode="numeric"
                    pattern="[0-9]*"
                    maxlength="1"
                    data-index="5"
                    class="otp-digit h-12 w-11 sm:h-14 sm:w-12 text-center text-xl sm:text-2xl font-bold font-mono rounded-xl border border-white/15 bg-white/[0.05] text-white shadow-inner focus:border-indigo-400 focus:bg-white/[0.08] focus:outline-none focus:ring-2 focus:ring-indigo-400/40 transition"
                    autocomplete="off"
                  />
                </div>
              </div>

              <button type="submit" id="verifyOtpBtn" class="btn-primary mt-2">
                <span>Verify OTP</span>
                <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
              </button>
            </form>

            <!-- Resend OTP Form (with 60-second cooldown) -->
            <div class="mt-4 text-center">
              <form action="/teacher/resend-otp" method="POST" id="resendOtpForm">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <input type="hidden" name="email" value="<%= email %>" />
                <p class="text-xs text-indigo-200/50">
                  Didn't receive code?
                  <button
                    type="submit"
                    id="resendBtn"
                    class="font-semibold text-indigo-300 hover:text-white transition underline underline-offset-4 disabled:opacity-40 disabled:no-underline disabled:cursor-not-allowed ml-1"
                    disabled
                  >
                    Resend Code (<span id="resendCountdown">60s</span>)
                  </button>
                </p>
              </form>
            </div>
          </div>

          <!-- Back link -->
          <div class="mt-6 text-center">
            <a href="/teacher/forgot-password" class="text-sm text-indigo-200/50 transition hover:text-white">
              <i class="fa-solid fa-arrow-left mr-1" aria-hidden="true"></i> Change Email Address
            </a>
          </div>
        </div>
      </main>
    </section>

    <!-- Interactive OTP Logic -->
    <script>
      (function () {
        var digits = Array.from(document.querySelectorAll('.otp-digit'));
        var combinedInput = document.getElementById('combinedOtpInput');
        var form = document.getElementById('verifyOtpForm');
        var verifyBtn = document.getElementById('verifyOtpBtn');
        var resendBtn = document.getElementById('resendBtn');
        var resendCountdown = document.getElementById('resendCountdown');
        var countdownTimer = document.getElementById('countdownTimer');

        // Expiration Countdown (5 minutes default or from server)
        var remainingSeconds = Number('<%= typeof remainingSeconds !== "undefined" ? remainingSeconds : 300 %>');
        var resendCooldown = Number('<%= typeof resendCooldown !== "undefined" ? resendCooldown : 60 %>');

        function updateExpiryDisplay() {
          if (remainingSeconds <= 0) {
            countdownTimer.textContent = 'Expired';
            countdownTimer.classList.add('text-rose-400');
            countdownTimer.classList.remove('text-indigo-300');
            verifyBtn.disabled = true;
            verifyBtn.classList.add('opacity-50', 'cursor-not-allowed');
            return;
          }
          var mins = Math.floor(remainingSeconds / 60);
          var secs = remainingSeconds % 60;
          countdownTimer.textContent = (mins < 10 ? '0' : '') + mins + ':' + (secs < 10 ? '0' : '') + secs;
          remainingSeconds--;
        }

        updateExpiryDisplay();
        var expiryInterval = setInterval(function () {
          if (remainingSeconds < 0) {
            clearInterval(expiryInterval);
          } else {
            updateExpiryDisplay();
          }
        }, 1000);

        // Resend Cooldown Countdown (60 seconds)
        function updateResendDisplay() {
          if (resendCooldown <= 0) {
            resendBtn.disabled = false;
            resendBtn.textContent = 'Resend Code';
            return;
          }
          resendBtn.disabled = true;
          resendCountdown.textContent = resendCooldown + 's';
          resendCooldown--;
        }

        updateResendDisplay();
        var resendInterval = setInterval(function () {
          if (resendCooldown < 0) {
            clearInterval(resendInterval);
            resendBtn.disabled = false;
            resendBtn.textContent = 'Resend Code';
          } else {
            updateResendDisplay();
          }
        }, 1000);

        // Sync individual digit inputs with hidden combined input
        function syncCombinedInput() {
          var val = digits.map(function(d) { return d.value; }).join('');
          combinedInput.value = val;
        }

        // Input & Key Navigation handlers
        digits.forEach(function (inp, idx) {
          inp.addEventListener('input', function (e) {
            var val = inp.value.replace(/\D/g, '');
            inp.value = val ? val[0] : '';
            syncCombinedInput();

            if (inp.value && idx < digits.length - 1) {
              digits[idx + 1].focus();
              digits[idx + 1].select();
            }

            // If all digits entered, auto-focus verify button
            if (combinedInput.value.length === 6) {
              verifyBtn.focus();
            }
          });

          inp.addEventListener('keydown', function (e) {
            if (e.key === 'Backspace' && !inp.value && idx > 0) {
              digits[idx - 1].focus();
              digits[idx - 1].value = '';
              syncCombinedInput();
            } else if (e.key === 'ArrowLeft' && idx > 0) {
              digits[idx - 1].focus();
            } else if (e.key === 'ArrowRight' && idx < digits.length - 1) {
              digits[idx + 1].focus();
            }
          });

          // Support Pasting Full 6-digit Code anywhere
          inp.addEventListener('paste', function (e) {
            e.preventDefault();
            var clipboardData = e.clipboardData || window.clipboardData;
            var pastedData = (clipboardData.getData('text') || '').replace(/\D/g, '').slice(0, 6);

            if (pastedData.length > 0) {
              for (var i = 0; i < digits.length; i++) {
                digits[i].value = pastedData[i] || '';
              }
              syncCombinedInput();
              var nextIdx = Math.min(pastedData.length, digits.length - 1);
              digits[nextIdx].focus();
              if (pastedData.length === 6) {
                verifyBtn.focus();
              }
            }
          });
        });

        // Form submit handler
        form.addEventListener('submit', function (e) {
          syncCombinedInput();
          if (combinedInput.value.length !== 6) {
            e.preventDefault();
            alert('Please enter all 6 digits of the verification code.');
            return false;
          }
          verifyBtn.disabled = true;
          verifyBtn.classList.add('opacity-75', 'cursor-not-allowed');
          verifyBtn.innerHTML = '<span>Verifying...</span> <i class="fa-solid fa-circle-notch fa-spin"></i>';
        });
      })();
    </script>
  </body>
</html>
