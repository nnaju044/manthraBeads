<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= student.name %> (<%= student.studentId %>) | ManthraBeads Teacher</title>
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/images/apple-touch-icon.png" />
    <meta name="description" content="ManthraBeads Student Profile — <%= student.name %>" />

    <!-- Tailwind CSS (CDN build w/ inline config) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              display: ['"Baloo 2"', '"Poppins"', 'sans-serif'],
              body: ['"Poppins"', 'sans-serif'],
            },
            colors: {
              night: {
                950: '#070a1f',
                900: '#0b0f2e',
                800: '#12183f',
                700: '#1a2150',
              },
            },
          },
        },
      };
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />

    <!-- Site & Teacher CSS -->
    <link rel="stylesheet" href="/css/site.css" />
    <link rel="stylesheet" href="/css/teacher.css" />
  </head>

  <body class="font-body bg-night-950 overflow-x-hidden min-h-screen text-slate-100">
    <section class="relative w-full min-h-screen bg-gradient-to-b from-[#0b1030] via-[#141b4d] to-[#0a1740] pb-20">

      <!-- Ambient Glow Orbs -->
      <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
        <div class="absolute -top-24 left-1/4 h-72 w-72 rounded-full bg-indigo-500/20 blur-[100px] sm:h-96 sm:w-96"></div>
        <div class="absolute top-1/3 right-0 h-64 w-64 rounded-full bg-fuchsia-500/10 blur-[120px] sm:h-[28rem] sm:w-[28rem]"></div>
        <div class="absolute bottom-0 left-1/2 h-56 w-56 -translate-x-1/2 rounded-full bg-cyan-400/10 blur-[100px] sm:h-72 sm:w-72"></div>
      </div>

      <!-- Navbar -->
      <%- include('../../partials/navbar') %>

      <!-- Main Container -->
      <main id="main-content" class="relative z-10 mx-auto max-w-[1240px] px-4 pt-6 sm:px-8 sm:pt-8 lg:px-12">

        <!-- Top Header & Breadcrumbs -->
        <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex items-center gap-3">
            <a
              href="/teacher/students"
              class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-indigo-200 transition hover:bg-white/10 hover:text-white"
              title="Back to Students Directory"
            >
              <i class="fa-solid fa-arrow-left"></i>
            </a>
            <div>
              <div class="flex flex-wrap items-center gap-2.5">
                <h1 class="font-display text-2xl font-bold text-white sm:text-3xl">
                  <%= student.name %>
                </h1>
                <span class="rounded-lg border border-indigo-400/30 bg-indigo-500/15 px-2.5 py-0.5 font-mono text-xs font-semibold text-indigo-300">
                  <%= student.studentId %>
                </span>
                <% if (student.status === 'active') { %>
                <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-400/30 bg-emerald-500/15 px-2.5 py-0.5 text-xs font-semibold text-emerald-300">
                  <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span> Active
                </span>
                <% } else { %>
                <span class="inline-flex items-center gap-1.5 rounded-full border border-rose-400/30 bg-rose-500/15 px-2.5 py-0.5 text-xs font-semibold text-rose-300">
                  <span class="h-1.5 w-1.5 rounded-full bg-rose-400"></span> Inactive
                </span>
                <% } %>
              </div>
              <p class="mt-0.5 text-xs text-indigo-200/60 sm:text-sm">
                <%= student.level %> &bull; Enrolled <%= new Date(student.enrollmentDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
              </p>
            </div>
          </div>

          <!-- Actions: Edit & Status Toggle -->
          <div class="flex items-center gap-2.5">
            <a
              href="/teacher/students/<%= student._id %>/edit"
              class="btn-ghost"
              title="Edit Student Information"
            >
              <i class="fa-solid fa-pen text-xs"></i>
              <span>Edit Profile</span>
            </a>

            <form
              action="/teacher/students/<%= student._id %>/status"
              method="POST"
              class="inline"
              onsubmit="return confirm('Are you sure you want to <%= student.status === 'active' ? 'deactivate' : 'reactivate' %> <%= student.name %>? Historical records will be preserved.');"
            >
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button
                type="submit"
                class="btn-ghost <%= student.status === 'active' ? 'hover:border-rose-400/50 hover:text-rose-300' : 'hover:border-emerald-400/50 hover:text-emerald-300' %>"
              >
                <i class="fa-solid <%= student.status === 'active' ? 'fa-user-slash' : 'fa-user-check' %> text-xs"></i>
                <span><%= student.status === 'active' ? 'Deactivate' : 'Reactivate' %></span>
              </button>
            </form>
          </div>
        </div>

        <!-- Alert Notification -->
        <% if (locals.alertMessage) { %>
        <div class="teacher-alert success mb-6">
          <i class="fa-solid fa-circle-check shrink-0"></i>
          <span><%= alertMessage %></span>
        </div>
        <% } %>

        <!-- Grid Layout: Info Cards & Upcoming Placeholders -->
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">

          <!-- ── Left Column (Profile Details) ── -->
          <div class="flex flex-col gap-6 lg:col-span-1">

            <!-- Card 1: Contact Details -->
            <section class="glass-card p-6">
              <h2 class="text-xs font-semibold uppercase tracking-wider text-indigo-300 mb-4 flex items-center gap-2">
                <i class="fa-solid fa-address-card text-indigo-400"></i> Contact Details
              </h2>

              <dl class="space-y-3.5 text-xs">
                <div>
                  <dt class="text-indigo-200/50">Primary Phone</dt>
                  <dd class="mt-0.5 font-medium text-white flex items-center gap-2">
                    <i class="fa-solid fa-phone text-[10px] text-indigo-300"></i>
                    <a href="tel:<%= student.phone %>" class="hover:underline"><%= student.phone %></a>
                  </dd>
                </div>

                <div>
                  <dt class="text-indigo-200/50">Parent / Guardian Name</dt>
                  <dd class="mt-0.5 font-medium text-white">
                    <%= student.parentName || '—' %>
                  </dd>
                </div>

                <div>
                  <dt class="text-indigo-200/50">Parent Email</dt>
                  <dd class="mt-0.5 font-medium text-white break-all">
                    <% if (student.parentEmail) { %>
                    <a href="mailto:<%= student.parentEmail %>" class="hover:underline text-indigo-200">
                      <%= student.parentEmail %>
                    </a>
                    <% } else { %>
                    <span class="text-indigo-200/40">Not provided</span>
                    <% } %>
                  </dd>
                </div>

                <div>
                  <dt class="text-indigo-200/50">Student Email</dt>
                  <dd class="mt-0.5 font-medium text-white break-all">
                    <% if (student.studentEmail) { %>
                    <a href="mailto:<%= student.studentEmail %>" class="hover:underline text-indigo-200">
                      <%= student.studentEmail %>
                    </a>
                    <% } else { %>
                    <span class="text-indigo-200/40">Not provided</span>
                    <% } %>
                  </dd>
                </div>
              </dl>
            </section>

            <!-- Card 2: Academic & Notes -->
            <section class="glass-card p-6">
              <h2 class="text-xs font-semibold uppercase tracking-wider text-indigo-300 mb-4 flex items-center gap-2">
                <i class="fa-solid fa-graduation-cap text-indigo-400"></i> Academic Info
              </h2>

              <dl class="space-y-3.5 text-xs">
                <div>
                  <dt class="text-indigo-200/50">Current Level</dt>
                  <dd class="mt-0.5">
                    <span class="inline-block rounded-lg border border-indigo-400/20 bg-indigo-500/10 px-2.5 py-1 text-xs font-medium text-indigo-200">
                      <%= student.level %>
                    </span>
                  </dd>
                </div>

                <div>
                  <dt class="text-indigo-200/50">Enrollment Date</dt>
                  <dd class="mt-0.5 font-medium text-white">
                    <%= new Date(student.enrollmentDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'long', year: 'numeric' }) %>
                  </dd>
                </div>

                <div>
                  <dt class="text-indigo-200/50">Notes & Observations</dt>
                  <dd class="mt-0.5 text-indigo-200/80 leading-relaxed bg-white/[0.02] p-2.5 rounded-lg border border-white/5">
                    <%= student.notes || 'No academic notes recorded for this student.' %>
                  </dd>
                </div>
              </dl>
            </section>

          </div>

          <!-- ── Right Column (Future Modules Placeholders) ── -->
          <div class="flex flex-col gap-6 lg:col-span-2">

            <!-- Card 3: Class Packages & Payment Ledger (Stage 4 Active) -->
            <section class="glass-card p-6 sm:p-7">
              <div class="mb-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                <div class="flex items-center gap-2.5">
                  <div class="flex h-9 w-9 items-center justify-center rounded-xl border border-white/10 bg-amber-500/15 text-amber-300">
                    <i class="fa-solid fa-credit-card text-sm"></i>
                  </div>
                  <div>
                    <h2 class="font-display text-base font-bold text-white">Prepaid Class Packages & Ledger</h2>
                    <p class="text-xs text-indigo-200/60">Class balance, fees received, and payment records</p>
                  </div>
                </div>

                <a
                  href="/teacher/students/<%= student._id %>/packages/new"
                  class="inline-flex items-center gap-1.5 rounded-xl bg-gradient-to-r from-amber-500 to-orange-500 px-3 py-1.5 text-xs font-semibold text-white shadow-sm transition hover:brightness-110 self-start sm:self-auto"
                >
                  <i class="fa-solid fa-plus text-[10px]"></i>
                  <span>Assign Package</span>
                </a>
              </div>

              <% if (locals.activePackage) { %>
              <!-- Active Package Summary Card -->
              <div class="rounded-xl border border-amber-500/20 bg-amber-500/[0.04] p-5 mb-5">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
                  <div>
                    <div class="flex items-center gap-2">
                      <h3 class="font-display text-base font-bold text-white"><%= activePackage.packageName %></h3>
                      <span class="rounded-full border border-emerald-400/30 bg-emerald-500/15 px-2 py-0.5 text-[10px] font-semibold text-emerald-300 uppercase">
                        Active
                      </span>
                    </div>
                    <p class="text-xs text-indigo-200/60 mt-0.5">
                      Purchased <%= new Date(activePackage.purchaseDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                    </p>
                  </div>

                  <div class="flex items-center gap-2">
                    <a
                      href="/teacher/packages/<%= activePackage._id %>/payments/new"
                      class="btn-ghost py-1 px-3 text-xs"
                    >
                      <i class="fa-solid fa-receipt text-[10px]"></i> Record Payment
                    </a>
                    <a
                      href="/teacher/packages/<%= activePackage._id %>"
                      class="btn-ghost py-1 px-3 text-xs"
                    >
                      Details &rarr;
                    </a>
                  </div>
                </div>

                <!-- Classes Progress Bar -->
                <div class="mb-4">
                  <div class="flex justify-between text-xs mb-1.5">
                    <span class="text-indigo-200/70">Class Credits</span>
                    <span class="font-medium text-white">
                      <span class="text-emerald-300 font-bold"><%= activePackage.remainingClasses %> remaining</span> of <%= activePackage.totalClasses %> classes (<%= activePackage.consumedClasses %> completed)
                    </span>
                  </div>
                  <div class="w-full bg-white/10 rounded-full h-2.5 overflow-hidden">
                    <% const pct = activePackage.totalClasses > 0 ? Math.min(100, Math.round((activePackage.consumedClasses / activePackage.totalClasses) * 100)) : 0; %>
                    <div class="bg-gradient-to-r from-indigo-500 to-emerald-400 h-2.5 rounded-full transition-all duration-300" style="width: <%= pct %>%;"></div>
                  </div>
                </div>

                <!-- 5 Distinct Financial Metrics Grid -->
                <div class="grid grid-cols-2 sm:grid-cols-5 gap-3 pt-3 border-t border-white/5 text-xs">
                  <div>
                    <span class="text-indigo-200/50 block text-[11px]">Package Price</span>
                    <span class="font-semibold text-white"><%= formatRupees(activePackage.totalPricePaise) %></span>
                  </div>
                  <div>
                    <span class="text-indigo-200/50 block text-[11px]">Amount Received</span>
                    <span class="font-semibold text-emerald-300"><%= formatRupees(activePackage.amountPaidPaise) %></span>
                  </div>
                  <div>
                    <span class="text-indigo-200/50 block text-[11px]">Outstanding Dues</span>
                    <span class="font-semibold <%= activePackage.outstandingDuesPaise > 0 ? 'text-amber-300' : 'text-slate-400' %>">
                      <%= formatRupees(activePackage.outstandingDuesPaise) %>
                    </span>
                  </div>
                  <div>
                    <span class="text-indigo-200/50 block text-[11px]">Consumed Value</span>
                    <span class="font-semibold text-indigo-200"><%= formatRupees(activePackage.consumedValuePaise) %></span>
                  </div>
                  <div>
                    <span class="text-indigo-200/50 block text-[11px]">Unused Prepaid</span>
                    <span class="font-semibold text-cyan-300"><%= formatRupees(activePackage.unusedPrepaidBalancePaise) %></span>
                  </div>
                </div>
              </div>

              <% } else if (locals.packages && packages.length > 0) { %>
              <div class="rounded-xl border border-white/10 bg-white/[0.02] p-4 text-center mb-5 text-xs text-indigo-200/70">
                <span>No active package. Previous packages are exhausted or closed.</span>
              </div>
              <% } else { %>
              <!-- Empty state when student has no packages -->
              <div class="empty-state-box p-6 mb-5">
                <div class="mb-2 flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-amber-500/10 text-amber-300/60">
                  <i class="fa-solid fa-receipt text-lg"></i>
                </div>
                <h3 class="font-display text-sm font-semibold text-white">No class packages assigned</h3>
                <p class="mt-1 max-w-sm text-xs text-indigo-200/60">
                  Assign a prepaid package (e.g. 4 classes for ₹1,000) to track class credits, dues, and payment records for <%= student.name %>.
                </p>
                <a
                  href="/teacher/students/<%= student._id %>/packages/new"
                  class="mt-3 inline-flex items-center gap-1.5 rounded-xl border border-amber-400/30 bg-amber-500/10 px-3 py-1.5 text-xs font-semibold text-amber-200 transition hover:bg-amber-500/20"
                >
                  <i class="fa-solid fa-plus text-[10px]"></i>
                  <span>Assign First Package</span>
                </a>
              </div>
              <% } %>

              <!-- Package History (if multiple packages exist) -->
              <% if (locals.packages && packages.length > 1) { %>
              <div class="mt-4 pt-4 border-t border-white/10">
                <h4 class="text-xs font-semibold uppercase tracking-wider text-indigo-300 mb-3">All Packages History</h4>
                <div class="space-y-2">
                  <% packages.forEach(function(p) { %>
                  <div class="flex items-center justify-between p-2.5 rounded-lg border border-white/5 bg-white/[0.02] text-xs">
                    <div class="flex items-center gap-2">
                      <span class="font-medium text-white"><%= p.packageName %></span>
                      <span class="rounded px-1.5 py-0.5 text-[10px] <%= p.status === 'active' ? 'bg-emerald-500/20 text-emerald-300' : 'bg-white/10 text-slate-400' %>">
                        <%= p.status %>
                      </span>
                    </div>
                    <div class="flex items-center gap-4 text-indigo-200/70">
                      <span><%= p.consumedClasses %>/<%= p.totalClasses %> classes</span>
                      <span class="font-semibold text-white"><%= formatRupees(p.totalPricePaise) %></span>
                      <a href="/teacher/packages/<%= p._id %>" class="text-indigo-300 hover:text-white">View</a>
                    </div>
                  </div>
                  <% }); %>
                </div>
              </div>
              <% } %>

              <!-- Payment Transactions Ledger for this student -->
              <% if (locals.payments && payments.length > 0) { %>
              <div class="mt-5 pt-4 border-t border-white/10">
                <h4 class="text-xs font-semibold uppercase tracking-wider text-indigo-300 mb-3 flex items-center gap-2">
                  <i class="fa-solid fa-receipt text-indigo-400"></i> Payment Transaction History
                </h4>
                <div class="overflow-x-auto">
                  <table class="w-full text-left text-xs">
                    <thead class="text-[10px] uppercase text-indigo-200/50 border-b border-white/5">
                      <tr>
                        <th class="py-2">Date</th>
                        <th class="py-2">Package</th>
                        <th class="py-2">Method</th>
                        <th class="py-2">Ref / UTR</th>
                        <th class="py-2 text-right">Amount</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-white/5">
                      <% payments.forEach(function(pay) { %>
                      <tr class="<%= pay.status === 'cancelled' ? 'opacity-40 line-through' : '' %>">
                        <td class="py-2 text-indigo-200/70">
                          <%= new Date(pay.paymentDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                        </td>
                        <td class="py-2 text-white truncate max-w-[120px]">
                          <%= pay.package ? pay.package.packageName : 'Package' %>
                        </td>
                        <td class="py-2 uppercase font-mono text-[11px] text-indigo-200/80">
                          <%= pay.paymentMethod %>
                        </td>
                        <td class="py-2 font-mono text-[11px] text-indigo-200/60">
                          <%= pay.referenceNumber || '—' %>
                        </td>
                        <td class="py-2 text-right font-semibold <%= pay.amountPaise >= 0 ? 'text-emerald-300' : 'text-rose-300' %>">
                          <%= formatRupees(pay.amountPaise) %>
                        </td>
                      </tr>
                      <% }); %>
                    </tbody>
                  </table>
                </div>
              </div>
              <% } %>

            </section>

            <!-- Card 4: Attendance History (Stage 5) -->
            <section class="glass-card p-6 sm:p-7">
              <div class="mb-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                <div class="flex items-center gap-2.5">
                  <div class="flex h-9 w-9 items-center justify-center rounded-xl border border-white/10 bg-emerald-500/15 text-emerald-300">
                    <i class="fa-solid fa-clipboard-check text-sm"></i>
                  </div>
                  <div>
                    <h2 class="font-display text-base font-bold text-white">Attendance & Session History</h2>
                    <p class="text-xs text-indigo-200/60">Class roll logs and completion history</p>
                  </div>
                </div>

                <div class="flex items-center gap-3">
                  <% if (locals.attendanceRate !== null && locals.attendanceRate !== undefined) { %>
                  <div class="text-right">
                    <span class="text-xs uppercase tracking-wider text-indigo-200/50 block text-[10px]">Turnout Rate</span>
                    <span class="text-xs font-bold text-emerald-300"><%= attendanceRate %>% (<%= attendedCount %>/<%= attendanceRecords.length %> classes)</span>
                  </div>
                  <% } %>
                  <a
                    href="/teacher/attendance"
                    class="rounded-lg border border-white/10 bg-white/5 px-2.5 py-1 text-xs font-semibold text-indigo-300 hover:bg-white/10 hover:text-white transition"
                  >
                    Take Attendance
                  </a>
                </div>
              </div>

              <% if (locals.attendanceRecords && attendanceRecords.length > 0) { %>
              <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                  <thead class="border-b border-white/10 text-[10px] uppercase text-indigo-200/50">
                    <tr>
                      <th class="py-2.5 px-3">Date</th>
                      <th class="py-2.5 px-3">Session</th>
                      <th class="py-2.5 px-3">Status</th>
                      <th class="py-2.5 px-3">Package Credit</th>
                      <th class="py-2.5 px-3">Notes</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-white/5">
                    <% attendanceRecords.forEach(function(rec) { %>
                    <tr class="hover:bg-white/[0.02] transition">
                      <td class="py-2.5 px-3 text-indigo-200/80 font-medium">
                        <%= new Date(rec.date).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                      </td>
                      <td class="py-2.5 px-3 text-white font-medium">
                        <%= rec.session ? rec.session.sessionName : 'Class Session' %>
                        <% if (rec.session && rec.session.startTime) { %>
                        <span class="block text-[10px] text-indigo-200/50"><%= rec.session.startTime %> - <%= rec.session.endTime %></span>
                        <% } %>
                      </td>
                      <td class="py-2.5 px-3">
                        <% if (rec.status === 'present') { %>
                        <span class="rounded px-2 py-0.5 text-[10px] font-semibold uppercase bg-emerald-500/20 text-emerald-300 border border-emerald-400/30">Present</span>
                        <% } else if (rec.status === 'late') { %>
                        <span class="rounded px-2 py-0.5 text-[10px] font-semibold uppercase bg-amber-500/20 text-amber-300 border border-amber-400/30">Late</span>
                        <% } else if (rec.status === 'absent') { %>
                        <span class="rounded px-2 py-0.5 text-[10px] font-semibold uppercase bg-rose-500/20 text-rose-300 border border-rose-400/30">Absent</span>
                        <% } else { %>
                        <span class="rounded px-2 py-0.5 text-[10px] font-semibold uppercase bg-blue-500/20 text-blue-300 border border-blue-400/30">Excused</span>
                        <% } %>
                      </td>
                      <td class="py-2.5 px-3">
                        <% if (rec.creditConsumed) { %>
                        <span class="inline-flex items-center gap-1 rounded bg-emerald-500/10 text-emerald-300 px-1.5 py-0.5 text-[10px] font-semibold">
                          <i class="fa-solid fa-check text-[9px]"></i> 1 Deducted
                        </span>
                        <% } else if (rec.creditStatus === 'reverted') { %>
                        <span class="rounded bg-slate-500/10 text-slate-400 px-1.5 py-0.5 text-[10px]">Reverted</span>
                        <% } else if (rec.creditStatus === 'no_package') { %>
                        <span class="rounded bg-amber-500/10 text-amber-300 px-1.5 py-0.5 text-[10px]">No Active Pack</span>
                        <% } else { %>
                        <span class="text-slate-500 text-[10px]">None</span>
                        <% } %>
                      </td>
                      <td class="py-2.5 px-3 text-slate-300 text-[11px] truncate max-w-[150px]">
                        <%= rec.notes || '—' %>
                      </td>
                    </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
              <% } else { %>
              <div class="empty-state-box p-6">
                <div class="mb-2 flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-emerald-500/10 text-emerald-300/60">
                  <i class="fa-solid fa-calendar-check text-lg"></i>
                </div>
                <h3 class="font-display text-sm font-semibold text-white">No attendance records yet</h3>
                <p class="mt-1 max-w-sm text-xs text-indigo-200/60 leading-relaxed">
                  Mark attendance for <%= student.name %> during scheduled class sessions to track attendance rates and automated package credit deductions.
                </p>
                <a
                  href="/teacher/attendance"
                  class="mt-3 inline-flex items-center gap-1.5 rounded-xl border border-emerald-400/30 bg-emerald-500/10 px-3 py-1.5 text-xs font-semibold text-emerald-200 transition hover:bg-emerald-500/20"
                >
                  <i class="fa-solid fa-clipboard-user text-[10px]"></i>
                  <span>Open Attendance Sheet</span>
                </a>
              </div>
              <% } %>
            </section>

          </div>

        </div>

      </main>
    </section>
  </body>
</html>
