<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Set New Password | ManthraBeads Teacher</title>
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
    <link rel="shortcut icon" href="/images/apple-touch-icon.png">
    <meta name="description" content="Set a new secure password for your teacher account." />

    <!-- Tailwind CSS (CDN build w/ inline config) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              display: ['"Baloo 2"', '"Poppins"', 'sans-serif'],
              body: ['"Poppins"', 'sans-serif'],
            },
            colors: {
              night: {
                950: '#070a1f',
                900: '#0b0f2e',
                800: '#12183f',
                700: '#1a2150',
              },
            },
            boxShadow: {
              glow: '0 0 25px rgba(255, 200, 60, 0.55)',
              'glow-blue': '0 0 30px rgba(80, 140, 255, 0.45)',
              'glow-pink': '0 0 25px rgba(255, 90, 200, 0.5)',
            },
          },
        },
      };
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
      integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />

    <!-- Site-wide responsive CSS & Teacher panel CSS -->
    <link rel="stylesheet" href="/css/site.css" />
    <link rel="stylesheet" href="/css/teacher.css" />
  </head>

  <body class="font-body bg-night-950 overflow-x-hidden">
    <section class="relative w-full min-h-screen overflow-x-hidden bg-gradient-to-b from-[#0b1030] via-[#141b4d] to-[#0a1740]">

      <!-- Starfield / ambient glow -->
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="absolute -top-24 left-1/4 h-72 w-72 rounded-full bg-indigo-500/20 blur-[100px] sm:h-96 sm:w-96"></div>
        <div class="absolute top-1/3 right-0 h-64 w-64 rounded-full bg-fuchsia-500/10 blur-[120px] sm:h-[28rem] sm:w-[28rem]"></div>
        <div class="absolute bottom-0 left-1/2 h-56 w-56 -translate-x-1/2 rounded-full bg-cyan-400/10 blur-[100px] sm:h-72 sm:w-72"></div>
      </div>

      <!-- Navbar -->
      <%- include('../partials/navbar') %>

      <!-- Set New Password Card -->
      <main id="main-content" class="relative z-10 flex items-center justify-center px-4 pt-12 pb-16 sm:pt-16">
        <div class="w-full max-w-md">

          <div class="glass-card p-6 sm:p-8">

            <!-- Icon & Heading -->
            <div class="mb-6 text-center sm:mb-8">
              <div class="mx-auto mb-3 flex h-16 w-16 items-center justify-center rounded-2xl border border-emerald-400/30 bg-emerald-500/10 text-emerald-400">
                <i class="fa-solid fa-lock-open text-2xl" aria-hidden="true"></i>
              </div>
              <h1 class="font-display text-2xl font-bold text-white sm:text-3xl">Set New Password</h1>
              <p class="mt-1 text-sm text-indigo-200/60">
                Choose a strong, secure password for your account.
              </p>
            </div>

            <!-- Error alert -->
            <% if (typeof error !== 'undefined' && error) { %>
              <div class="teacher-alert error mb-4">
                <i class="fa-solid fa-circle-exclamation shrink-0 text-rose-400" aria-hidden="true"></i>
                <span><%= error %></span>
              </div>
            <% } %>

            <!-- Form -->
            <form action="/teacher/reset-password" method="POST" id="resetPasswordForm" class="flex flex-col gap-4">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

              <!-- New Password -->
              <div>
                <label for="newPassword" class="mb-1.5 block text-xs font-semibold uppercase tracking-wider text-indigo-200/60">
                  New Password
                </label>
                <div class="relative">
                  <input
                    type="password"
                    id="newPassword"
                    name="newPassword"
                    required
                    minlength="8"
                    autocomplete="new-password"
                    placeholder="At least 8 characters"
                    class="teacher-input pr-11"
                  />
                  <button
                    type="button"
                    id="toggleNewPassword"
                    class="absolute right-3 top-1/2 -translate-y-1/2 text-indigo-200/40 transition hover:text-white"
                    aria-label="Toggle password visibility"
                    tabindex="-1"
                  >
                    <i id="eyeNewIcon" class="fa-solid fa-eye text-sm"></i>
                  </button>
                </div>
                <p class="mt-1 text-[11px] text-indigo-200/40">Minimum 8 characters.</p>
              </div>

              <!-- Confirm New Password -->
              <div>
                <label for="confirmPassword" class="mb-1.5 block text-xs font-semibold uppercase tracking-wider text-indigo-200/60">
                  Confirm New Password
                </label>
                <div class="relative">
                  <input
                    type="password"
                    id="confirmPassword"
                    name="confirmPassword"
                    required
                    minlength="8"
                    autocomplete="new-password"
                    placeholder="Repeat your new password"
                    class="teacher-input pr-11"
                  />
                  <button
                    type="button"
                    id="toggleConfirmPassword"
                    class="absolute right-3 top-1/2 -translate-y-1/2 text-indigo-200/40 transition hover:text-white"
                    aria-label="Toggle confirm password visibility"
                    tabindex="-1"
                  >
                    <i id="eyeConfirmIcon" class="fa-solid fa-eye text-sm"></i>
                  </button>
                </div>
              <!-- Show passwords option -->
              <div class="mt-1 flex items-center">
                <label for="showPasswordsCheckbox" class="flex items-center gap-2 cursor-pointer select-none text-xs text-indigo-200/70 hover:text-indigo-100 transition">
                  <input
                    type="checkbox"
                    id="showPasswordsCheckbox"
                    class="h-3.5 w-3.5 rounded border-white/20 bg-white/5 text-indigo-500 focus:ring-1 focus:ring-indigo-400 focus:ring-offset-0 cursor-pointer"
                  />
                  <span>Show passwords</span>
                </label>
              </div>

              <button type="submit" id="resetSubmitBtn" class="btn-primary mt-2">
                <span>Update Password</span>
                <i class="fa-solid fa-check" aria-hidden="true"></i>
              </button>
            </form>
          </div>

          <!-- Back link -->
          <div class="mt-6 text-center">
            <a href="/teacher/login" class="text-sm text-indigo-200/50 transition hover:text-white">
              <i class="fa-solid fa-arrow-left mr-1" aria-hidden="true"></i> Back to Login
            </a>
          </div>
        </div>
      </main>
    </section>

    <!-- Interactive script -->
    <script>
      (function () {
        var toggleNew = document.getElementById('toggleNewPassword');
        var inputNew = document.getElementById('newPassword');
        var iconNew = document.getElementById('eyeNewIcon');

        var toggleConfirm = document.getElementById('toggleConfirmPassword');
        var inputConfirm = document.getElementById('confirmPassword');
        var iconConfirm = document.getElementById('eyeConfirmIcon');

        var showAllCheckbox = document.getElementById('showPasswordsCheckbox');

        function setNewVisibility(show) {
          if (!inputNew) return;
          inputNew.type = show ? 'text' : 'password';
          if (iconNew) {
            iconNew.classList.toggle('fa-eye', !show);
            iconNew.classList.toggle('fa-eye-slash', show);
          }
          if (toggleNew) {
            toggleNew.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
          }
        }

        function setConfirmVisibility(show) {
          if (!inputConfirm) return;
          inputConfirm.type = show ? 'text' : 'password';
          if (iconConfirm) {
            iconConfirm.classList.toggle('fa-eye', !show);
            iconConfirm.classList.toggle('fa-eye-slash', show);
          }
          if (toggleConfirm) {
            toggleConfirm.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
          }
        }

        if (toggleNew && inputNew) {
          toggleNew.addEventListener('click', function () {
            var show = inputNew.type === 'password';
            setNewVisibility(show);
            if (showAllCheckbox) {
              showAllCheckbox.checked = inputNew.type === 'text' && inputConfirm && inputConfirm.type === 'text';
            }
          });
        }

        if (toggleConfirm && inputConfirm) {
          toggleConfirm.addEventListener('click', function () {
            var show = inputConfirm.type === 'password';
            setConfirmVisibility(show);
            if (showAllCheckbox) {
              showAllCheckbox.checked = inputConfirm.type === 'text' && inputNew && inputNew.type === 'text';
            }
          });
        }

        if (showAllCheckbox) {
          showAllCheckbox.addEventListener('change', function () {
            var show = showAllCheckbox.checked;
            setNewVisibility(show);
            setConfirmVisibility(show);
          });
        }

        // Form submit handler with mismatch check and duplicate submission prevention
        var form = document.getElementById('resetPasswordForm');
        var btn = document.getElementById('resetSubmitBtn');
        if (form && btn) {
          form.addEventListener('submit', function (e) {
            if (inputNew.value !== inputConfirm.value) {
              e.preventDefault();
              alert('New passwords do not match. Please verify and try again.');
              inputConfirm.focus();
              return false;
            }
            if (inputNew.value.length < 8) {
              e.preventDefault();
              alert('Password must be at least 8 characters long.');
              inputNew.focus();
              return false;
            }
            btn.disabled = true;
            btn.classList.add('opacity-75', 'cursor-not-allowed');
            btn.innerHTML = '<span>Updating Password...</span> <i class="fa-solid fa-circle-notch fa-spin"></i>';
          });
        }
      })();
    </script>
  </body>
</html>
