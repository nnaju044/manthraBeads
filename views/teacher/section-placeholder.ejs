<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= section.title %> | ManthraBeads Teacher</title>
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/images/apple-touch-icon.png" />
    <meta name="description" content="ManthraBeads teacher panel — <%= section.title %>" />

    <!-- Tailwind CSS (CDN build w/ inline config) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              display: ['"Baloo 2"', '"Poppins"', 'sans-serif'],
              body: ['"Poppins"', 'sans-serif'],
            },
            colors: {
              night: {
                950: '#070a1f',
                900: '#0b0f2e',
                800: '#12183f',
                700: '#1a2150',
              },
            },
          },
        },
      };
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />

    <!-- Site & Teacher CSS -->
    <link rel="stylesheet" href="/css/site.css" />
    <link rel="stylesheet" href="/css/teacher.css" />
  </head>

  <body class="font-body bg-night-950 overflow-x-hidden min-h-screen text-slate-100">
    <section class="relative w-full min-h-screen bg-gradient-to-b from-[#0b1030] via-[#141b4d] to-[#0a1740] pb-16">

      <!-- Ambient Glows -->
      <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
        <div class="absolute -top-24 left-1/4 h-72 w-72 rounded-full bg-indigo-500/20 blur-[100px] sm:h-96 sm:w-96"></div>
        <div class="absolute top-1/3 right-0 h-64 w-64 rounded-full bg-fuchsia-500/10 blur-[120px] sm:h-[28rem] sm:w-[28rem]"></div>
        <div class="absolute bottom-0 left-1/2 h-56 w-56 -translate-x-1/2 rounded-full bg-cyan-400/10 blur-[100px] sm:h-72 sm:w-72"></div>
      </div>

      <!-- Navbar -->
      <%- include('../partials/navbar') %>

      <!-- Main Layout -->
      <main id="main-content" class="relative z-10 mx-auto max-w-[1340px] px-4 pt-6 sm:px-8 sm:pt-8 lg:px-12">

        <!-- Top sub-header -->
        <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex items-center gap-3">
            <a
              href="/teacher/dashboard"
              class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-indigo-200 transition hover:bg-white/10 hover:text-white"
              title="Back to Dashboard"
            >
              <i class="fa-solid fa-arrow-left"></i>
            </a>
            <div>
              <div class="flex items-center gap-2">
                <h1 class="font-display text-2xl font-bold text-white sm:text-3xl">
                  <%= section.title %>
                </h1>
                <span class="rounded-full border border-indigo-400/30 bg-indigo-500/15 px-2.5 py-0.5 text-xs font-semibold text-indigo-300">
                  <%= section.stage %>
                </span>
              </div>
              <p class="text-xs text-indigo-200/60 sm:text-sm">
                Teacher Panel Module
              </p>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <a href="/teacher/dashboard" class="btn-ghost">
              <i class="fa-solid fa-table-cells-large"></i> Dashboard
            </a>
          </div>
        </div>

        <!-- Section Navigation Bar -->
        <nav class="mb-8 flex flex-wrap gap-2 rounded-2xl border border-white/10 bg-white/[0.03] p-1.5 backdrop-blur-md">
          <a
            href="/teacher/dashboard"
            class="teacher-tab <%= (locals.activeSection || '') === 'dashboard' ? 'active' : '' %>"
          >
            <i class="fa-solid fa-gauge-high"></i>
            <span>Dashboard</span>
          </a>
          <a
            href="/teacher/students"
            class="teacher-tab <%= (locals.activeSection || '') === 'students' ? 'active' : '' %>"
          >
            <i class="fa-solid fa-user-graduate"></i>
            <span>Students</span>
          </a>
          <a
            href="/teacher/attendance"
            class="teacher-tab <%= (locals.activeSection || '') === 'attendance' ? 'active' : '' %>"
          >
            <i class="fa-solid fa-clipboard-check"></i>
            <span>Attendance</span>
            <span class="tab-badge">Stage 5</span>
          </a>
          <a
            href="/teacher/packages"
            class="teacher-tab <%= (locals.activeSection || '') === 'packages' ? 'active' : '' %>"
          >
            <i class="fa-solid fa-credit-card"></i>
            <span>Packages & Payments</span>
            <span class="tab-badge">Stage 4</span>
          </a>
          <a
            href="/teacher/reports"
            class="teacher-tab <%= (locals.activeSection || '') === 'reports' ? 'active' : '' %>"
          >
            <i class="fa-solid fa-chart-pie"></i>
            <span>Reports</span>
            <span class="tab-badge">Stage 5</span>
          </a>
        </nav>

        <!-- Placeholder Showcase Card -->
        <div class="glass-card mx-auto max-w-2xl p-8 sm:p-12 text-center">
          <div class="mx-auto mb-5 flex h-20 w-20 items-center justify-center rounded-2xl border border-indigo-400/20 bg-gradient-to-br from-indigo-500/20 to-violet-500/20 shadow-lg shadow-indigo-500/10">
            <i class="fa-solid <%= section.icon %> text-3xl text-indigo-300" aria-hidden="true"></i>
          </div>

          <span class="inline-block rounded-full border border-indigo-400/30 bg-indigo-500/15 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-indigo-200 mb-3">
            <%= section.stage %> Feature
          </span>

          <h2 class="font-display text-2xl font-bold text-white mb-3">
            <%= section.title %> Coming in <%= section.stage %>
          </h2>

          <p class="text-sm text-indigo-200/70 max-w-lg mx-auto leading-relaxed mb-8">
            <%= section.description %>
          </p>

          <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
            <a href="/teacher/dashboard" class="btn-primary sm:w-auto px-6">
              <i class="fa-solid fa-arrow-left"></i>
              Back to Dashboard Overview
            </a>
          </div>
        </div>

      </main>
    </section>
  </body>
</html>
