<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Page Not Found (404) — ManthraBeads Abacus Academy</title>
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              sans: ['"Plus Jakarta Sans"', 'sans-serif'],
              display: ['"Outfit"', 'sans-serif'],
            },
            colors: {
              space: { 950: '#060714', 900: '#0b0d26', 850: '#0f1235', 800: '#141843' },
            },
          },
        },
      };
    </script>
    <link rel="stylesheet" href="/css/site.css" />
  </head>
  <body class="min-h-full bg-space-950 text-slate-100 flex flex-col justify-center items-center px-4 py-16 selection:bg-indigo-500/30 selection:text-white">
    <!-- Glow Background -->
    <div class="pointer-events-none fixed inset-0 overflow-hidden">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 h-[500px] w-[500px] rounded-full bg-gradient-to-tr from-indigo-600/20 via-purple-600/15 to-pink-600/10 blur-[130px]"></div>
    </div>

    <div class="relative z-10 text-center max-w-md mx-auto">
      <div class="inline-flex h-20 w-20 items-center justify-center rounded-3xl border border-white/10 bg-white/5 text-indigo-400 shadow-[0_0_35px_rgba(99,102,241,0.3)] mb-6">
        <span class="font-display text-4xl font-extrabold tracking-tight text-white">404</span>
      </div>
      <h1 class="font-display text-2xl font-bold text-white sm:text-3xl mb-3">
        Page Not Found
      </h1>
      <p class="text-xs sm:text-sm text-indigo-200/70 mb-8 leading-relaxed">
        The page you are looking for doesn't exist, has been moved, or is temporarily unavailable.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href="/"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-full bg-gradient-to-r from-indigo-500 to-violet-500 px-6 py-2.5 text-xs font-semibold text-white shadow-[0_0_20px_rgba(99,102,241,0.4)] transition hover:brightness-110"
        >
          <i class="fa-solid fa-house text-xs"></i>
          <span>Return Home</span>
        </a>
        <a
          href="/teacher/dashboard"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-full border border-white/10 bg-white/5 px-6 py-2.5 text-xs font-semibold text-slate-200 hover:bg-white/10 hover:text-white transition"
        >
          <i class="fa-solid fa-gauge-high text-xs"></i>
          <span>Teacher Portal</span>
        </a>
      </div>
    </div>
  </body>
</html>
