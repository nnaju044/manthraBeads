<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>About Maths Manthra</title>
    <meta name="description" content="Learn about Maths Manthra's mission, vision, and programs including Abacus, Vedic Maths, Online Tuition, Edupreneur Workshops, Digital Marketing, and AI." />

    <!-- Tailwind CSS (CDN build w/ inline config) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              display: ['"Baloo 2"', '"Poppins"', "sans-serif"],
              body: ['"Poppins"', "sans-serif"],
            },
            colors: {
              night: {
                950: "#070a1f",
                900: "#0b0f2e",
                800: "#12183f",
                700: "#1a2150",
              },
            },
            boxShadow: {
              glow: "0 0 25px rgba(255, 200, 60, 0.55)",
              "glow-blue": "0 0 30px rgba(80, 140, 255, 0.45)",
              "glow-pink": "0 0 25px rgba(255, 90, 200, 0.5)",
            },
          },
        },
      };
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
      integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />

    <!-- Site-wide responsive CSS -->
    <link rel="stylesheet" href="/css/site.css" />
  </head>

  <body class="font-body bg-night-950 text-indigo-100 overflow-x-hidden">
    <section class="relative w-full overflow-x-hidden bg-gradient-to-b from-[#0b1030] via-[#141b4d] to-[#0a1740] min-h-screen pb-16 sm:pb-20">

      <!-- Starfield / ambient glow background -->
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="absolute -top-24 left-1/4 h-72 w-72 rounded-full bg-indigo-500/20 blur-[100px] sm:h-96 sm:w-96"></div>
        <div class="absolute top-1/3 right-0 h-64 w-64 rounded-full bg-fuchsia-500/10 blur-[120px] sm:h-[28rem] sm:w-[28rem]"></div>
        <div class="absolute bottom-0 left-1/2 h-56 w-56 -translate-x-1/2 rounded-full bg-cyan-400/10 blur-[100px] sm:h-72 sm:w-72"></div>
        <span class="absolute top-[8%] left-[15%] h-1 w-1 rounded-full bg-white/70"></span>
        <span class="absolute top-[18%] left-[45%] h-1 w-1 rounded-full bg-white/50"></span>
        <span class="absolute top-[6%] left-[70%] h-1.5 w-1.5 rounded-full bg-white/60"></span>
        <span class="absolute top-[40%] left-[8%] h-1 w-1 rounded-full bg-white/40"></span>
        <span class="absolute top-[65%] left-[92%] h-1 w-1 rounded-full bg-white/50"></span>
      </div>

      <!-- NAVBAR -->
      <%- include('partials/navbar') %>

      <!-- PAGE HEADER + MAIN CONTENT -->
      <main id="main-content" class="relative z-10 mx-auto max-w-[1024px] px-4 pt-10 sm:px-8 sm:pt-14 lg:px-14">

        <!-- Page header -->
        <header class="text-center mb-10 sm:mb-14">
          <h1 class="font-display font-extrabold tracking-tight text-white fluid-h1 mb-4">
            About&nbsp;<span class="bg-gradient-to-r from-fuchsia-400 to-orange-300 bg-clip-text text-transparent">Maths&nbsp;Manthra</span>
          </h1>
          <p class="fluid-body text-indigo-200/80 max-w-xl mx-auto">Transforming Learning, Empowering Futures</p>
        </header>

        <!-- MAIN CONTENT -->
        <div class="space-y-10 sm:space-y-14">

          <!-- Intro -->
          <div class="about-intro-card rounded-2xl border border-white/10 bg-white/5 p-5 backdrop-blur-md sm:p-8">
            <p class="fluid-body leading-relaxed mb-4 sm:mb-6">
              Maths Manthra is an innovative learning platform dedicated to helping students, teachers, and aspiring edupreneurs unlock their full potential through skill-based education and modern learning solutions.
            </p>
            <p class="fluid-body leading-relaxed">
              We believe that education should go beyond textbooks. Our programs are designed to build strong academic foundations, develop practical skills, and prepare learners for a rapidly evolving digital world.
            </p>
          </div>

          <!-- What We Offer -->
          <section aria-labelledby="offerings-heading">
            <h2 id="offerings-heading" class="font-display fluid-h2 font-bold text-white mb-6 border-b border-white/10 pb-4 sm:mb-8">What We Offer</h2>

            <!-- 1 col → 2 col (tablet) → 3 col (desktop) -->
            <div class="card-grid-3">

              <!-- Abacus Training -->
              <article class="rounded-2xl border border-white/10 bg-white/5 p-5 backdrop-blur-sm transition-all hover:-translate-y-1 hover:shadow-[0_0_30px_rgba(80,140,255,0.2)] sm:p-6">
                <div class="mb-4 text-3xl text-fuchsia-400" aria-hidden="true"><i class="fa-solid fa-calculator"></i></div>
                <h3 class="font-display fluid-h3 font-bold text-white mb-2 sm:mb-3">Abacus Training</h3>
                <p class="text-sm text-indigo-200/80 leading-relaxed">Our Abacus program helps children improve mental arithmetic, concentration, memory, visualization, and problem-solving skills. Students learn to perform calculations quickly and confidently while enhancing overall brain development.</p>
              </article>

              <!-- Vedic Mathematics -->
              <article class="rounded-2xl border border-white/10 bg-white/5 p-5 backdrop-blur-sm transition-all hover:-translate-y-1 hover:shadow-[0_0_30px_rgba(80,140,255,0.2)] sm:p-6">
                <div class="mb-4 text-3xl text-orange-400" aria-hidden="true"><i class="fa-solid fa-square-root-variable"></i></div>
                <h3 class="font-display fluid-h3 font-bold text-white mb-2 sm:mb-3">Vedic Mathematics</h3>
                <p class="text-sm text-indigo-200/80 leading-relaxed">We teach powerful Vedic Math techniques that simplify complex calculations, improve speed and accuracy, and make mathematics enjoyable for students.</p>
              </article>

              <!-- Online Tuition -->
              <article class="rounded-2xl border border-white/10 bg-white/5 p-5 backdrop-blur-sm transition-all hover:-translate-y-1 hover:shadow-[0_0_30px_rgba(80,140,255,0.2)] sm:p-6">
                <div class="mb-4 text-3xl text-cyan-400" aria-hidden="true"><i class="fa-solid fa-laptop-code"></i></div>
                <h3 class="font-display fluid-h3 font-bold text-white mb-2 sm:mb-3">Online Tuition Programs</h3>
                <p class="text-sm text-indigo-200/80 leading-relaxed">We provide personalized online tuition classes for students, helping them strengthen subject knowledge, improve academic performance, and build confidence in their studies.</p>
              </article>

              <!-- Edupreneur Workshop -->
              <article class="rounded-2xl border border-white/10 bg-white/5 p-5 backdrop-blur-sm transition-all hover:-translate-y-1 hover:shadow-[0_0_30px_rgba(80,140,255,0.2)] sm:p-6">
                <div class="mb-4 text-3xl text-emerald-400" aria-hidden="true"><i class="fa-solid fa-chalkboard-user"></i></div>
                <h3 class="font-display fluid-h3 font-bold text-white mb-2 sm:mb-3">Edupreneur Workshop</h3>
                <p class="text-sm text-indigo-200/80 leading-relaxed">Our Edupreneur Workshops are designed for teachers and educators who want to build successful educational ventures. Participants learn how to create, grow, and manage education-based businesses while making a meaningful impact in their communities.</p>
              </article>

              <!-- Digital Marketing -->
              <article class="rounded-2xl border border-white/10 bg-white/5 p-5 backdrop-blur-sm transition-all hover:-translate-y-1 hover:shadow-[0_0_30px_rgba(80,140,255,0.2)] sm:p-6">
                <div class="mb-4 text-3xl text-pink-400" aria-hidden="true"><i class="fa-solid fa-bullhorn"></i></div>
                <h3 class="font-display fluid-h3 font-bold text-white mb-2 sm:mb-3">Digital Marketing for Teachers</h3>
                <p class="text-sm text-indigo-200/80 leading-relaxed">We empower teachers with practical digital marketing skills, enabling them to build their personal brand, attract students, promote courses, and grow their educational initiatives online.</p>
              </article>

              <!-- AI Workshop -->
              <article class="rounded-2xl border border-white/10 bg-white/5 p-5 backdrop-blur-sm transition-all hover:-translate-y-1 hover:shadow-[0_0_30px_rgba(80,140,255,0.2)] sm:p-6">
                <div class="mb-4 text-3xl text-indigo-400" aria-hidden="true"><i class="fa-solid fa-robot"></i></div>
                <h3 class="font-display fluid-h3 font-bold text-white mb-2 sm:mb-3">One-Day AI Workshop</h3>
                <p class="text-sm text-indigo-200/80 leading-relaxed">Our AI Workshop introduces participants to the exciting world of Artificial Intelligence. Teachers, students, and professionals learn how to use AI tools effectively to enhance productivity, creativity, teaching, and learning.</p>
              </article>

            </div>
          </section>

          <!-- Vision & Mission — 1 col mobile, 2 col tablet+ -->
          <section aria-labelledby="vision-mission-heading" class="sr-only">
            <h2 id="vision-mission-heading">Vision and Mission</h2>
          </section>
          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 sm:gap-8">
            <div class="rounded-2xl border border-white/10 bg-gradient-to-br from-indigo-900/40 to-[#0b0f2e]/40 p-5 backdrop-blur-md sm:p-8">
              <h2 class="font-display fluid-h3 font-bold text-white mb-4 flex items-center gap-2">
                <i class="fa-solid fa-eye text-cyan-400" aria-hidden="true"></i>Our Vision
              </h2>
              <p class="text-sm text-indigo-200/80 leading-relaxed sm:text-base">
                To create a generation of confident learners and empowered educators by combining traditional educational excellence with modern technology and innovation.
              </p>
            </div>

            <div class="rounded-2xl border border-white/10 bg-gradient-to-br from-fuchsia-900/30 to-[#0b0f2e]/40 p-5 backdrop-blur-md sm:p-8">
              <h2 class="font-display fluid-h3 font-bold text-white mb-4 flex items-center gap-2">
                <i class="fa-solid fa-bullseye text-fuchsia-400" aria-hidden="true"></i>Our Mission
              </h2>
              <ul class="space-y-2.5 sm:space-y-3 text-sm text-indigo-200/80 list-none sm:text-base">
                <li class="flex items-start gap-3"><i class="fa-solid fa-check text-green-400 mt-1 shrink-0" aria-hidden="true"></i> To strengthen students' academic and cognitive abilities.</li>
                <li class="flex items-start gap-3"><i class="fa-solid fa-check text-green-400 mt-1 shrink-0" aria-hidden="true"></i> To make mathematics simple, engaging, and enjoyable.</li>
                <li class="flex items-start gap-3"><i class="fa-solid fa-check text-green-400 mt-1 shrink-0" aria-hidden="true"></i> To empower teachers with entrepreneurial and digital skills.</li>
                <li class="flex items-start gap-3"><i class="fa-solid fa-check text-green-400 mt-1 shrink-0" aria-hidden="true"></i> To promote the responsible use of emerging technologies such as Artificial Intelligence.</li>
                <li class="flex items-start gap-3"><i class="fa-solid fa-check text-green-400 mt-1 shrink-0" aria-hidden="true"></i> To build a learning ecosystem that inspires growth, creativity, and lifelong success.</li>
              </ul>
            </div>
          </div>

          <!-- Why Choose Us -->
          <section aria-labelledby="why-us-heading">
            <h2 id="why-us-heading" class="font-display fluid-h2 font-bold text-white mb-6 text-center sm:mb-8">Why Choose Maths Manthra?</h2>

            <!-- Pill badges — flex-wrap handles responsiveness automatically -->
            <div class="flex flex-wrap justify-center gap-3">
              <div class="flex items-center gap-2 rounded-full border border-indigo-500/30 bg-indigo-500/10 px-4 py-2.5 text-sm text-indigo-100">
                <i class="fa-solid fa-star text-yellow-400 shrink-0" aria-hidden="true"></i> Experienced &amp; dedicated trainers
              </div>
              <div class="flex items-center gap-2 rounded-full border border-indigo-500/30 bg-indigo-500/10 px-4 py-2.5 text-sm text-indigo-100">
                <i class="fa-solid fa-user-graduate text-fuchsia-400 shrink-0" aria-hidden="true"></i> Student-focused learning approach
              </div>
              <div class="flex items-center gap-2 rounded-full border border-indigo-500/30 bg-indigo-500/10 px-4 py-2.5 text-sm text-indigo-100">
                <i class="fa-solid fa-gears text-cyan-400 shrink-0" aria-hidden="true"></i> Practical &amp; skill-oriented programs
              </div>
              <div class="flex items-center gap-2 rounded-full border border-indigo-500/30 bg-indigo-500/10 px-4 py-2.5 text-sm text-indigo-100">
                <i class="fa-solid fa-globe text-emerald-400 shrink-0" aria-hidden="true"></i> Online &amp; offline learning opportunities
              </div>
              <div class="flex items-center gap-2 rounded-full border border-indigo-500/30 bg-indigo-500/10 px-4 py-2.5 text-sm text-indigo-100">
                <i class="fa-solid fa-lightbulb text-orange-400 shrink-0" aria-hidden="true"></i> Innovative teaching methodologies
              </div>
              <div class="flex items-center gap-2 rounded-full border border-indigo-500/30 bg-indigo-500/10 px-4 py-2.5 text-sm text-indigo-100">
                <i class="fa-solid fa-rocket text-pink-400 shrink-0" aria-hidden="true"></i> Future-ready courses
              </div>
            </div>

            <!-- Quote card -->
            <blockquote class="about-quote mt-10 sm:mt-12 mx-auto rounded-2xl bg-white/5 border border-white/10 p-5 text-center sm:p-8 max-w-3xl">
              <p class="font-display fluid-body text-white italic leading-relaxed sm:text-lg sm:leading-relaxed">
                "At Maths Manthra, we are committed to shaping brighter futures by helping students excel academically and empowering educators to thrive in the digital age."
              </p>
            </blockquote>

          </section>

        </div>
      </main>
    </section>
  </body>
</html>
