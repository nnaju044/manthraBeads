# ─── MongoDB Atlas ───
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/manthrabeads?retryWrites=true&w=majority

# ─── Session Secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ───
SESSION_SECRET=

# ─── Email & OTP Delivery (Notifications & Password Reset) ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="ManthraBeads Academy <notifications@manthrabeads.com>"
EMAIL_FROM="ManthraBeads Academy <notifications@manthrabeads.com>"
EMAIL_DEV_MODE=false
ENABLE_ABSENCE_EMAILS=false

# ─── App ───

NODE_ENV=development
